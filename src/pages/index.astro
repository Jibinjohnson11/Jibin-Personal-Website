---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';
import CtaLine from '../components/CtaLine.astro';
import FaqSection from '../components/FaqSection.astro';
import ServiceCards from '../components/ServiceCards.astro';
import WorkStack from '../components/WorkStack.astro';
import Toolkit from '../components/Toolkit.astro';
import WhereIWork from '../components/WhereIWork.astro';
import {
	siHtml5,
	siCss,
	siJavascript,
	siBootstrap,
	siPython,
	siDjango,
	siPostgresql,
	siMongodb,
	siGit,
	siGithub,
	siGooglesearchconsole,
	siGoogleanalytics,
	siPandas,
	siNumpy,
	siClaude,
} from 'simple-icons';
import { SITE } from '../data/site';
import { getPerson, PERSON_ID } from '../lib/person';
import portrait from '../assets/images/jibin-johnson.jpg';
import heroImage from '../assets/images/hero/jibin-johnson-hero-v2.png';
import webArt from '../assets/images/services/website-development-services-kerala.webp';
import seoArt from '../assets/images/services/seo-services-kerala.webp';
import djangoArt from '../assets/images/services/python-django-developer-kerala.webp';
import aiArt from '../assets/images/services/ai-assisted-development-kerala.webp';
import webAppArt from '../assets/images/services/web-application-development-kerala.webp';
import landingArt from '../assets/images/services/landing-page-development-kerala.webp';
import hostingArt from '../assets/images/services/website-hosting-deployment-kerala.webp';
import performanceArt from '../assets/images/services/website-performance-optimization-kerala.webp';
import deskPhoto from '../assets/images/why/jibin-at-desk.webp';
import redesignArt from '../assets/images/services/website-redesign-services-kerala.webp';

const title = 'Web Developer in Kerala & SEO Specialist | Jibin Johnson';
const description =
	'Web developer and SEO specialist in Trivandrum, Kerala. I build fast, responsive websites ready for search, and custom Python Django apps.';

const services = [
	{
		name: 'Website Development',
		text: 'Responsive, fast websites with clean HTML, CSS, and JavaScript, built with search and usability in mind.',
		url: '/services/web-development/',
		anchor: 'Website development services in Kerala',
		image: webArt,
		alt: 'Laptop on a dark stone desk in warm evening light, showing a code editor beside a live website preview',
		position: '40% center',
		tint: '#120d08',
		accent: '#d4a373',
	},
	{
		name: 'SEO Services',
		text: 'Technical, on-page, and off-page SEO: keyword research, site fixes, content, and link building, tracked in Google Search Console and Google Analytics.',
		url: '/services/seo/',
		anchor: 'SEO services in Kerala',
		image: seoArt,
		alt: 'Laptop showing a search engine home page, with glowing green, blue and red ranking charts rising behind it',
		tint: '#060b08',
		accent: '#7ed98a',
	},
	{
		name: 'Python & Django Development',
		text: 'Custom web applications and internal tools, from database design to the interface your team uses every day.',
		url: '/services/python-django-development/',
		anchor: 'Python Django development',
		image: djangoArt,
		alt: 'Developer in headphones at a desk with a laptop and six monitors showing code, an API architecture diagram and a traffic chart',
		tint: '#060c12',
		accent: '#6cb8e6',
	},
	{
		name: 'AI-Assisted Development',
		text: 'I use AI tools such as Claude and ChatGPT to research, build, and debug faster, and I review everything they produce before it ships.',
		image: aiArt,
		alt: 'Friendly white robot on a glowing desk platform, surrounded by AI tool and coding icons, with an open notebook of sketches in front',
		tint: '#0a0a1c',
		accent: '#9aa6ff',
	},
	{
		name: 'Web Application Development',
		text: 'Browser-based apps with user accounts, dashboards, and forms that save to a real database, built in Django and tested before launch.',
		url: '/services/python-django-development/',
		anchor: 'Django web application development',
		image: webAppArt,
		alt: 'Laptop showing a web app dashboard with a sidebar, performance chart and project progress ring, beside a floating code snippet',
		tint: '#050b18',
		accent: '#4fa8ff',
	},
	{
		name: 'Landing Page Development',
		text: 'Single pages built around one goal, like enquiries or sign-ups, with a clear layout, fast load times, and tracking set up from day one.',
		url: '/services/web-development/',
		anchor: 'Landing page development',
		image: landingArt,
		alt: 'Laptop showing a green and white landing page, with three more sample landing pages for travel, fitness and furniture stacked behind it',
		tint: '#0a1a13',
		accent: '#a8d5ba',
	},
	{
		name: 'Hosting & Deployment',
		text: "I put your site live, set up the domain and HTTPS, and make sure updates go out without breaking what's already working.",
		url: '/services/web-development/',
		anchor: 'Website hosting and deployment',
		image: hostingArt,
		alt: 'Laptop showing a deployment pipeline from code to live, in front of glowing green servers and a cloud with an upload arrow',
		tint: '#06140e',
		accent: '#4fd18b',
	},
	{
		name: 'Website Performance Optimization',
		text: 'I find what slows your pages down, from heavy images to blocking scripts, fix it, and measure the result with Lighthouse.',
		url: '/services/seo/',
		anchor: 'Technical SEO and site speed',
		image: performanceArt,
		alt: 'Isometric glowing platform with a globe, rising green bar charts, a speed gauge, a code window and a search bar',
		tint: '#050a1e',
		accent: '#8ee04f',
	},
	{
		name: 'Website Revamp & Redesign',
		text: 'Transform outdated websites into modern, responsive, and user-friendly experiences with improved design, performance, and usability.',
		url: '/services/website-redesign/',
		anchor: 'Website redesign services in Kerala',
		image: redesignArt,
		alt: 'Old laptop with a dull grey website and an arrow pointing to a new laptop showing a bright, modern redesign, on a marble desk',
		tint: '#071615',
		accent: '#5fd6c9',
	},
];

const tools = [
	{ name: 'HTML5', icon: siHtml5 },
	{ name: 'CSS3', icon: siCss },
	{ name: 'JavaScript', icon: siJavascript },
	{ name: 'Bootstrap', icon: siBootstrap },
	{ name: 'Python', icon: siPython },
	{ name: 'Django', icon: siDjango },
	{ name: 'PostgreSQL', icon: siPostgresql },
	{ name: 'MongoDB', icon: siMongodb },
	{ name: 'Git', icon: siGit },
	{ name: 'GitHub', icon: siGithub },
	{ name: 'Google Search Console', icon: siGooglesearchconsole },
	{ name: 'Google Analytics', icon: siGoogleanalytics },
	{ name: 'Pandas', icon: siPandas },
	{ name: 'NumPy', icon: siNumpy },
	{ name: 'Claude', icon: siClaude },
	{ name: 'ChatGPT', mono: 'GPT', hex: '10a37f' },
];

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const reasons = [
	{ lead: 'One person for code and search', text: 'Your site is built to rank, without a handover between a developer and an SEO agency.' },
	{ lead: 'Responsive by default', text: 'Every page is tested on phones, tablets, and desktops before launch.' },
	{ lead: 'Problem first, then code', text: "I start with what's slowing your business down and build only what solves it." },
	{ lead: 'Faster delivery with AI tools', text: 'I use AI to speed up research and development, and I check every line it writes.' },
	{ lead: 'Usability and performance', text: 'Clear layouts, readable text, and fast load times, measured with Lighthouse.' },
];

const steps = [
	{ name: 'Discovery', text: 'We talk about your goals, audience, and the searches you want to be found for.' },
	{ name: 'Planning', text: 'I map out the pages, content, and keywords, and agree a timeline with you.' },
	{ name: 'Design and development', text: 'I build the site or app, sharing progress so you can give feedback early.' },
	{ name: 'Testing and optimization', text: 'I check speed, mobile layout, accessibility, and on-page SEO before launch.' },
	{ name: 'Launch and support', text: 'I set up Google Search Console and Analytics, launch, and stay available for fixes and updates.' },
];

// Shown on the page and reused word for word in the FAQPage schema.
const faqs = [
	{
		q: 'How much does a website cost?',
		a: "It depends on the number of pages, features, and content. Share what you need and I'll send a fixed quote with a breakdown before any work starts.",
	},
	{
		q: 'How long does it take to build a website?',
		a: "A small business site usually takes 2 to 4 weeks once content is ready. Larger sites and web applications take longer, and I'll give you a timeline during planning.",
	},
	{
		q: 'Is SEO included with every website?',
		a: 'Every site I build includes on-page SEO basics: clean structure, page titles, meta descriptions, fast loading, and a sitemap. Ongoing SEO, such as content and link building, is a separate service.',
	},
	{
		q: 'How long does SEO take to show results?',
		a: "Usually a few months, depending on your competition and your site's current state. I'll explain what to expect after looking at your site, and I don't promise rankings in a fixed time.",
	},
	{
		q: 'What technologies do you use?',
		a: 'HTML, CSS, and JavaScript for websites, and Python with Django and PostgreSQL for web applications. I recommend the simplest option that fits your needs.',
	},
	{
		q: 'Can you work on my existing website?',
		a: 'Yes. I can fix technical SEO issues, improve speed and mobile layout, or redesign specific pages without rebuilding everything.',
	},
	{
		q: 'Do you work with clients outside Kerala?',
		a: 'Yes. I work remotely with clients across India and abroad.',
	},
	{
		q: 'Are you available for full-time roles?',
		a: "Yes. I'm open to full-time roles in web development, Python and Django development, and SEO, as well as freelance projects.",
	},
];

const pad = (n: number) => String(n).padStart(2, '0');

const homeUrl = `${SITE.url}/`;

const schema = [
	{ '@context': 'https://schema.org', ...(await getPerson()) },
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		'@id': `${homeUrl}#website`,
		name: SITE.name,
		url: homeUrl,
		inLanguage: 'en-IN',
		publisher: { '@id': PERSON_ID },
	},
	// Locality only: there's no public street address, so none is given here.
	{
		'@context': 'https://schema.org',
		'@type': 'ProfessionalService',
		'@id': `${homeUrl}#service`,
		name: SITE.name,
		url: homeUrl,
		email: SITE.email,
		founder: { '@id': PERSON_ID },
		areaServed: [
			{ '@type': 'State', name: 'Kerala' },
			{ '@type': 'Country', name: 'India' },
		],
		address: {
			'@type': 'PostalAddress',
			addressLocality: 'Thiruvananthapuram',
			addressRegion: 'Kerala',
			addressCountry: 'IN',
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqs.map((faq) => ({
			'@type': 'Question',
			name: faq.q,
			acceptedAnswer: { '@type': 'Answer', text: faq.a },
		})),
	},
];
---

<BaseLayout title={title} description={description} schema={schema}>
	<!-- Hero -->
	<section class="hero screen screen--first" aria-labelledby="hero-title">
		<div class="container">
			<div class="grid hero__grid">
				<div class="hero__text">
					<SectionLabel text="Web developer · SEO · Thiruvananthapuram" />
					<h1 id="hero-title" class="hero__title" data-reveal="hero">Web Developer and SEO Specialist <em>in Kerala</em></h1>
					<p class="lead hero__lead" data-reveal style="--reveal-delay: 350ms">
						I'm Jibin Johnson. I build fast, responsive websites that are ready for search from day one, and I use Python, Django, and AI tools to automate the work behind them. I'm based in Thiruvananthapuram (Trivandrum) and work with businesses across Kerala and beyond.
					</p>
					<div class="hero__actions" data-reveal style="--reveal-delay: 500ms">
						<Button href="/contact/">Start a project</Button>
						<Button variant="link" href="/work/">See my work</Button>
					</div>
				</div>
				<!-- sizes follows the CSS below: phones min(68vw, 17.5rem); tablets ~5/12 cols × 88%;
				     desktop capped by max-height 46rem at the image's 0.66 ratio (~485px). -->
				<figure class="hero__media" data-reveal="hero" style="--reveal-delay: 450ms">
					<Image
						src={heroImage}
						alt="Jibin Johnson in a cream linen shirt and olive chinos, leaning on a large glowing teal letter J"
						widths={[320, 480, 640, 800, 1018]}
						sizes="(min-width: 960px) 485px, (min-width: 768px) 37vw, min(68vw, 280px)"
						quality={80}
						loading="eager"
						fetchpriority="high"
					/>
				</figure>
			</div>
		</div>
	</section>

	<!-- 01 About -->
	<section class="page-section container about" aria-labelledby="about-title">
		<div class="grid about__grid">
			<div class="col-label about__label"><SectionLabel text="About" /></div>

			<figure class="about__portrait" data-reveal>
				<div class="about__frame">
					<Image
						src={portrait}
						alt="Jibin Johnson smiling, wearing a navy blazer over a white T-shirt, against a plain cream wall"
						widths={[320, 480, 640, 832]}
						sizes="(min-width: 900px) 28rem, 20rem"
						quality={78}
					/>
				</div>
				<figcaption class="label">Jibin Johnson · Trivandrum</figcaption>
			</figure>

			<span class="about__divider" aria-hidden="true" data-reveal></span>

			<div class="col-content stack about__content">
				<h2 id="about-title" data-reveal="lines">Where web development <em>meets search</em></h2>
				<p class="lead" data-reveal>
					Most websites get built first and optimized later. I do both together. At Prception Medialab in Thiruvananthapuram, I build responsive websites and run SEO for clients in healthcare, education, and hospitality, and I lead the SEO and web team for BlackBox Learning, an AI training academy.
				</p>
				<p data-reveal>
					Running SEO campaigns showed me how much time goes into manual coordination, so I started building software to handle it. That path led me to a PG in Artificial Intelligence and to full-stack work in Python and Django.
				</p>
				<div class="about__actions" data-reveal>
					<Button href={SITE.resume} download="Jibin-Johnson-Resume.pdf" class="about__resume">
						Download Resume<span class="visually-hidden"> (PDF)</span>
						<svg class="about__resume-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
							<path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M2.5 13.5h11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
						</svg>
					</Button>
					<Button variant="link" href="/about/">More about me</Button>
				</div>
			</div>
		</div>
	</section>

	<!-- 01b Where I work: pinned company showcase (data in src/data/experience.ts) -->
	<WhereIWork />

	<!-- 02 Services and skills: one screen on desktop, cards on top and the toolkit below -->
	<section class="page-section container services-skills" aria-labelledby="services-title">
		<div class="grid section-head">
			<div class="col-label"><SectionLabel text="Services" /></div>
			<div class="col-content">
				<h2 id="services-title" data-reveal="lines">What I can <em>help you with</em></h2>
			</div>
		</div>

		<ServiceCards items={services} />

		<div class="skills">
			<Toolkit tools={tools}>
				<h2 id="skills-title" data-reveal="lines">Tools I <em>work with</em></h2>
			</Toolkit>
		</div>
	</section>

	<!-- 04 + 05: Why me slides up over Selected work (see .cover-stack in global.css) -->
	<div class="cover-stack" data-cover-stack>
	<!-- 04 Selected work -->
	<section class="page-section page-section--midnight container" aria-labelledby="work-title" data-cover-under>
		<div class="grid section-head">
			<div class="col-label"><SectionLabel text="Work" /></div>
			<div class="col-content">
				<h2 id="work-title" data-reveal="lines">Selected <em>work</em></h2>
			</div>
		</div>

		<WorkStack projects={projects} />

		<CtaLine />
	</section>

	<!-- 05 Why work with me -->
	<section class="page-section page-section--cover why container" aria-labelledby="why-title" data-cover-over>
		<div class="why__layout">
			<div class="why__head">
				<div class="why__intro">
					<SectionLabel text="Why me" class="why__label" />
					<h2 id="why-title" class="why__title" data-reveal="lines">Why work <em>with me</em></h2>
				</div>
				<Image
					src={deskPhoto}
					alt="Working on a laptop at a wooden desk, with a notebook and a black coffee mug"
					class="why__art"
					data-reveal
					style="--reveal-delay: 150ms"
					widths={[420, 640, 830]}
					sizes="(min-width: 1240px) 600px, (min-width: 1024px) 48vw, (min-width: 640px) 46vw, calc(100vw - 2.5rem)"
					loading="lazy"
					decoding="async"
				/>
			</div>

			<ol class="why-list" role="list">
				{
					reasons.map((reason, i) => (
						<li class="why-list__item" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
							<span class="why-list__num" aria-hidden="true">{pad(i + 1)}</span>
							<div class="why-list__body">
								<h3 class="why-list__lead">{reason.lead}</h3>
								<p>{reason.text}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>
	</div>

	<!-- 06 Process -->
	<section class="page-section page-section--midnight process-section container" aria-labelledby="process-title">
		<div class="grid section-head">
			<div class="col-label"><SectionLabel text="Process" /></div>
			<div class="col-content">
				<h2 id="process-title" data-reveal="lines">How a project <em>works</em></h2>
			</div>
		</div>

		<ol class="process" role="list">
			{
				steps.map((step, i) => (
					<li class="process__step" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
						<span class="label">{pad(i + 1)}</span>
						<h3 class="process__name">{step.name}</h3>
						<p>{step.text}</p>
					</li>
				))
			}
		</ol>
	</section>

	<!-- 07 FAQ -->
	<FaqSection items={faqs} />
</BaseLayout>

<script>
/* Why me covers Selected work. Selected work pins once its bottom edge reaches the
   bottom of the screen (after the project cards have finished stacking), and Why me
   scrolls up over it. Sticky needs a top offset, so this measures it:
   screen height minus section height. CSS does the rest. */
const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)');

document.querySelectorAll<HTMLElement>('[data-cover-stack]').forEach((stack) => {
	const under = stack.querySelector<HTMLElement>('[data-cover-under]');
	const over = stack.querySelector<HTMLElement>('[data-cover-over]');
	if (!under || !over) return;

	const measure = () => {
		const on = motionOk.matches;
		stack.classList.toggle('is-covering', on);
		if (on) under.style.setProperty('--pin-top', `${Math.min(0, window.innerHeight - under.offsetHeight)}px`);
	};

	new ResizeObserver(measure).observe(under);
	window.addEventListener('resize', measure, { passive: true });
	motionOk.addEventListener('change', measure);

	// Tabbing back into Selected work while Why me covers it: scroll back until Why me
	// is below the screen again, so the focused link is visible.
	under.addEventListener('focusin', () => {
		if (!stack.classList.contains('is-covering')) return;
		const overTop = over.getBoundingClientRect().top;
		if (overTop < window.innerHeight) window.scrollBy({ top: overTop - window.innerHeight, behavior: 'instant' });
	});

	measure();
});
</script>

<style>
	/* --- Hero ---
	   Phones: text, then the portrait, with fluid spacing so more of the portrait
	   shows on the first screen. Tablet: text and portrait side by side.
	   Desktop (960px+): unchanged. */
	.hero {
		padding-block: clamp(1.5rem, 7vw, 3rem) clamp(2.5rem, 9vw, 3rem);
	}

	.hero__grid {
		align-items: end;
		row-gap: clamp(2rem, 9vw, 3rem);
	}

	.hero__title {
		margin-block: clamp(1rem, 4vw, 1.5rem) clamp(1.25rem, 5vw, 2rem);
	}

	/* A touch smaller on phones so the hero reads lighter */
	.hero__lead {
		max-width: 38rem;
		font-size: clamp(1rem, 0.93rem + 0.35vw, 1.0625rem);
		line-height: 1.6;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4) clamp(1.25rem, 6vw, 2rem);
		margin-top: clamp(1.5rem, 6vw, 2rem);
	}

	/* The whole figure always shows (no cropping): its size comes from the image's own
	   proportions, capped by width and by screen height so head and feet both fit. */
	.hero__media {
		justify-self: center;
		width: min(78vw, 20rem);
	}

	.hero__media img {
		display: block;
		width: 100%;
		height: auto;
		max-height: min(70svh, 32rem);
		margin-inline: auto;
		object-fit: contain;
	}

	/* Phones: one column in reading order: eyebrow, heading, portrait, intro, buttons.
	   The text wrapper steps aside (display: contents) so the portrait can sit between
	   the heading and the intro without changing the markup. Every item shares the
	   container's side margins and one vertical rhythm: the eyebrow sits close to the
	   heading it labels, everything else shares one gap (1.5rem, up to 1.75rem on
	   larger phones). The hero sizes to its content here instead of filling a whole
	   screen, so there are no empty bands above or below it. */
	@media (max-width: 767px) {
		.hero {
			--hero-gap: clamp(1.5rem, 6vw, 1.75rem);
			min-height: auto;
			padding-block: var(--space-4) var(--space-6);
		}

		.hero__grid {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
		}

		.hero__text {
			display: contents;
		}

		.hero__text > :global(.section-label) {
			order: 1;
			margin: 0;
		}

		.hero__title {
			order: 2;
			margin: var(--space-4) 0 0;
			line-height: 1.05;
		}

		/* About 12% smaller than before (was min(78vw, 20rem) wide, 70svh / 32rem tall).
		   Still uncropped: height follows the image's own proportions. */
		.hero__media {
			order: 3;
			align-self: center;
			width: min(68vw, 17.5rem);
			margin: var(--hero-gap) 0 0;
		}

		.hero__media img {
			max-height: min(60svh, 28rem);
		}

		.hero__lead {
			order: 4;
			max-width: 34rem;
			margin: var(--hero-gap) 0 0;
		}

		/* Both buttons the same height, centred on one line */
		.hero__actions {
			order: 5;
			flex-wrap: nowrap;
			align-items: center;
			gap: var(--space-5);
			margin-top: var(--hero-gap);
		}

		.hero__actions > :global(.btn) {
			min-height: 3rem;
			flex-shrink: 0;
		}
	}

	/* Tablet: side by side, text 7 columns, portrait 5, centred on each other */
	@media (min-width: 768px) {
		.hero {
			padding-block: var(--space-7);
		}

		.hero__grid {
			align-items: center;
		}

		.hero__grid > .hero__text {
			grid-column: 1 / span 7;
		}

		.hero__lead {
			font-size: var(--text-lead);
			line-height: 1.55;
		}

		.hero__grid > .hero__media {
			grid-column: 8 / span 5;
			justify-self: end;
			width: 100%;
		}

		.hero__media img {
			max-height: min(72svh, 40rem);
			margin-inline: auto 0;
		}
	}

	/* Tablet only (768 to 959px): the portrait about 12% smaller, still right-aligned */
	@media (min-width: 768px) and (max-width: 959px) {
		.hero__grid > .hero__media {
			width: 88%;
		}

		.hero__media img {
			max-height: min(63svh, 35rem);
		}
	}

	/* Desktop: text left, photo right (as before) */
	@media (min-width: 960px) {
		.hero {
			padding-block: var(--space-8) var(--space-7);
		}

		.hero__title {
			margin-block: var(--space-5) var(--space-6);
		}

		.hero__actions {
			gap: var(--space-4) var(--space-6);
			margin-top: var(--space-6);
		}

		.hero__grid > .hero__media {
			width: auto;
		}

		.hero__media img {
			width: auto;
			max-height: min(82svh, 46rem);
		}
	}

	/* --- Services --- */
	/* The card carousel is full-bleed (100vw, which includes any scrollbar). Clip sideways
	   overflow at <main>, not the section, which is only container-wide. Home page only. */
	:global(main) {
		overflow-x: clip;
	}

	/* --- About --- */
	.about__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4) var(--space-6);
	}

	.about__resume :global(.btn__text) {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}

	/* Arrow dips into the tray on hover */
	.about__resume-icon {
		transition: transform var(--dur-base) var(--ease-out);
	}

	.about__resume:hover .about__resume-icon {
		transform: translateY(2px);
	}

	/* Mobile and tablet: label, portrait, then text, stacked */
	.about__portrait {
		width: min(100%, 20rem);
	}

	/* Thin teal frame with an inset gap around the photo */
	.about__frame {
		position: relative;
		padding: var(--space-3);
		border: 1px solid var(--accent);
	}

	/* Corner accents: four short L-shaped brackets just outside the frame */
	.about__frame::before {
		--c: 1.25rem;
		--t: 2px;
		content: '';
		position: absolute;
		inset: -0.5rem;
		pointer-events: none;
		background:
			linear-gradient(var(--accent), var(--accent)) top left / var(--c) var(--t),
			linear-gradient(var(--accent), var(--accent)) top left / var(--t) var(--c),
			linear-gradient(var(--accent), var(--accent)) top right / var(--c) var(--t),
			linear-gradient(var(--accent), var(--accent)) top right / var(--t) var(--c),
			linear-gradient(var(--accent), var(--accent)) bottom left / var(--c) var(--t),
			linear-gradient(var(--accent), var(--accent)) bottom left / var(--t) var(--c),
			linear-gradient(var(--accent), var(--accent)) bottom right / var(--c) var(--t),
			linear-gradient(var(--accent), var(--accent)) bottom right / var(--t) var(--c);
		background-repeat: no-repeat;
	}

	.about__portrait img {
		width: 100%;
		height: auto;
		border-radius: var(--radius);
		background: var(--surface-muted);
	}

	/* Caption centred under the photo at every width. The frame is always centred in
	   the figure (full width on desktop, auto side margins below 900px), so centring
	   the text across the figure puts its centre on the image's centre. The corner
	   accents reach 0.5rem below the frame; a 1rem gap leaves 0.5rem clear. */
	.about__portrait figcaption {
		margin-top: var(--space-4);
		text-align: center;
	}

	.about__divider {
		display: none;
	}

	.about__content p {
		max-width: 36rem;
	}

	@media (min-width: 768px) {
		.about__grid > .about__label,
		.about__grid > .about__content,
		.about__grid > .about__portrait {
			grid-column: 1 / -1;
		}

		.about__portrait {
			width: min(100%, 22rem);
		}
	}

	/* Phones and tablets (under 900px): label with an emerald rule running right, the
	   framed portrait centred, then caption, heading, text and buttons on one shared
	   left edge. One vertical rhythm (--about-gap) between the blocks, and the
	   section sizes to its content instead of filling a whole screen. */
	@media (max-width: 899px) {
		.about {
			--about-gap: clamp(1.75rem, 6vw, 2.25rem);
			min-height: auto;
		}

		.about__grid {
			row-gap: var(--about-gap);
		}

		.about__label {
			display: flex;
			align-items: center;
			gap: var(--space-4);
		}

		.about__label :global(.section-label) {
			flex-shrink: 0;
			margin: 0;
		}

		/* The figure spans the full width so its caption shares the text's left edge;
		   only the framed photo is centred. Slightly smaller than before (was 20rem /
		   22rem wide). 0.5rem of side room keeps the corner accents inside the margins. */
		.about__grid > .about__portrait {
			--about-frame-w: min(calc(100% - 1rem), 17.5rem);
			width: 100%;
			margin: 0;
		}

		.about__frame {
			width: var(--about-frame-w);
			margin-inline: auto;
		}

		.about__content {
			--stack-gap: var(--space-5);
		}

		.about__content > h2 + * {
			margin-top: var(--space-5);
		}

		/* Both buttons the same height, left-aligned; if they wrap on a narrow phone
		   the second one starts on the same left edge. */
		.about__actions {
			margin-top: var(--about-gap);
			gap: var(--space-3) var(--space-5);
		}

		.about__actions > :global(.btn) {
			min-height: 3rem;
		}
	}

	@media (min-width: 768px) and (max-width: 899px) {
		.about__grid > .about__portrait {
			--about-frame-w: min(calc(100% - 1rem), 19.5rem);
		}
	}

	/* Side by side: photo left, hairline divider, label and text right */
	@media (min-width: 900px) {
		/* Empty 1fr rows above and below centre the label and text against the photo */
		.about__grid {
			grid-template-rows: 1fr auto auto 1fr;
			row-gap: 0;
		}

		.about__grid > .about__portrait {
			grid-column: 1 / span 5;
			grid-row: 1 / -1;
			align-self: center;
			justify-self: start;
			width: min(100%, 28rem);
		}

		.about__grid > .about__divider {
			display: block;
			grid-column: 6 / span 1;
			grid-row: 1 / -1;
			justify-self: center;
			width: 1px;
			background: var(--rule);
		}

		.about__grid > .about__label {
			grid-column: 7 / span 6;
			grid-row: 2;
			margin-bottom: var(--space-6);
		}

		.about__grid > .about__content {
			grid-column: 7 / span 6;
			grid-row: 3;
		}
	}

	/* Entrance: the photo wipes up inside its frame, the corners fade in after,
	   and the divider draws down. Only while html.js-reveal is set, so reduced
	   motion and no-JS visitors see everything static. */
	:global(.js-reveal) .about__portrait img {
		clip-path: inset(100% 0 0 0);
		transition: clip-path 1.1s var(--ease-out) 150ms;
	}

	:global(.js-reveal) .about__portrait.is-revealed img {
		clip-path: inset(0);
	}

	:global(.js-reveal) .about__frame::before {
		opacity: 0;
		transition: opacity var(--dur-slow) var(--ease-out) 700ms;
	}

	:global(.js-reveal) .about__portrait.is-revealed .about__frame::before {
		opacity: 1;
	}

	:global(.js-reveal) .about__divider[data-reveal] {
		opacity: 1;
		transform: scaleY(0);
		transform-origin: top;
		transition: transform 1.2s var(--ease-out) 250ms;
	}

	:global(.js-reveal) .about__divider[data-reveal].is-revealed {
		transform: none;
	}

	/* --- Services and skills --- */
	/* On desktop the cards shrink with the screen height (--card-max is read by ServiceCards)
	   so heading, cards and toolkit share one screen. Smaller screens let the section grow. */
	.services-skills .section-head {
		margin-bottom: var(--space-5);
	}

	@media (min-width: 1024px) {
		.services-skills {
			--card-max: clamp(15rem, 100svh - 36rem, 26rem);
			padding-block: var(--space-6);
		}
	}

	.skills {
		margin-top: var(--space-5);
		padding-top: var(--space-5);
		border-top: var(--hairline);
	}

	/* --- Why work with me ---
	   The section keeps .page-section--cover (it still slides up over Selected work);
	   its background is the site's Warm Ivory (--paper, #FAF6E8).

	   Three independent layouts, so a change at one size can't leak into another:
	   - shared rules below: colours, number style, hover, transitions (all sizes)
	   - max-width 1023.98px: phones (photo beside the title, bleeding off the edge)
	     and, from 640px, tablets (photo back inside the margins)
	   - min-width 1024px: desktop two-column editorial layout (heading and photo on
	     the left, the list on the right of a faint vertical hairline) */
	.why {
		--ink: #101114; /* Midnight Black */
		--ink-2: #33373d; /* body copy, 11:1 on the ivory */
		--ink-3: #5c6367; /* muted grey, 5.7:1 on the ivory */
		--accent: #006b5b; /* Deep Teal Green, 6.2:1 on the ivory */
		--rule: rgb(16 17 20 / 0.11);
		--why-gutter: clamp(2rem, 4.5vw, 4.5rem);
		/* Width of the fixed back-to-top / WhatsApp column (FloatingActions.astro: size +
		   edge inset), minus the page margin, plus a little air. On phones and tablets the
		   list keeps this much clear on the right so the buttons never sit over a title
		   or description. */
		--why-fab: 2.75rem;
		--why-fab-room: max(0px, calc(var(--why-fab) + clamp(0.875rem, 4vw, 1.5rem) + 0.5rem - var(--container-pad)));
		padding-block: clamp(3.5rem, 8vh, 6rem) clamp(2.5rem, 6vh, 4.5rem);
		color: var(--ink);
	}

	.why__layout {
		display: grid;
	}

	.why :global(.why__label) {
		letter-spacing: 0.14em;
	}

	.why__title {
		line-height: 0.98;
		letter-spacing: -0.02em;
	}

	/* "with me" on its own line, italic teal (colour from the global h2 em rule) */
	.why__title em {
		display: block;
		letter-spacing: -0.01em;
	}

	/* Desk photo. Its wall is colour-matched to the ivory; the mask only lowers opacity
	   at the edges (no dark overlay), so the sides and the desk dissolve into the page
	   without a frame or a band. The fade stops are set per layout below. */
	.why__art {
		display: block;
		height: auto;
		-webkit-mask-image: var(--why-art-fade-x), var(--why-art-fade-y);
		-webkit-mask-composite: source-in;
		mask-image: var(--why-art-fade-x), var(--why-art-fade-y);
		mask-composite: intersect;
	}

	.why-list {
		position: relative;
		min-width: 0;
	}

	.why-list__item {
		position: relative;
		display: grid;
		align-items: baseline; /* number sits on the title's baseline */
	}

	/* Teal line that draws across the row's top hairline on hover */
	.why-list__item + .why-list__item::before {
		content: '';
		position: absolute;
		inset-inline: 0;
		top: -1px;
		height: 1px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--dur-slow) var(--ease-out);
	}

	/* Italic serif number followed by a fine light-grey slash */
	.why-list__num {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: var(--font-serif);
		font-style: italic;
		line-height: 1;
		font-variant-numeric: lining-nums tabular-nums;
		color: var(--accent);
		transition:
			transform var(--dur-base) var(--ease-out),
			opacity var(--dur-base) var(--ease-out);
	}

	.why-list__num::after {
		content: '';
		flex: none;
		width: 1px;
		height: 0.8em;
		background: var(--ink-3);
		opacity: 0.35;
		transform: rotate(24deg);
		transition:
			background-color var(--dur-base) var(--ease-out),
			opacity var(--dur-base) var(--ease-out);
	}

	.why-list__body {
		min-width: 0;
		transition: opacity var(--dur-base) var(--ease-out);
	}

	.why-list__lead {
		line-height: 1.2;
		letter-spacing: -0.005em;
		transition: color var(--dur-base) var(--ease-out);
	}

	.why-list__body p {
		line-height: 1.6;
		color: var(--ink-2);
		transition: color var(--dur-base) var(--ease-out);
	}

	/* Hover: the row takes the teal and its line draws in. Other rows stay at full
	   opacity, so every item reads the same whatever the pointer is resting on. */
	@media (hover: hover) {
		.why-list__item:hover::before {
			transform: scaleX(1);
		}

		.why-list__item:hover .why-list__num {
			transform: translateX(4px);
		}

		.why-list__item:hover .why-list__num::after {
			background-color: var(--accent);
			opacity: 1;
		}

		.why-list__item:hover .why-list__lead {
			color: var(--accent);
		}

		.why-list__item:hover p {
			color: var(--ink);
		}
	}

	/* --- Phones and tablets (below 1024px). Nothing here reaches desktop. --- */
	@media (max-width: 1023.98px) {
		.why__layout {
			gap: clamp(2.5rem, 6vw, 4.5rem);
		}

		/* Heading row: title on the left, photo on the right. On phones the photo
		   tucks in beside the title and runs off the right edge of the screen. */
		.why__head {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr);
			align-items: center;
		}

		.why__intro {
			position: relative;
			z-index: 1; /* title stays above the photo's faded left edge */
			min-width: 0;
		}

		/* Short emerald rule under the label */
		.why :global(.why__label)::after {
			content: '';
			display: block;
			width: 2rem;
			height: 2px;
			margin-top: var(--space-3);
			background: var(--accent);
		}

		.why__title {
			margin-top: var(--space-5);
			font-size: clamp(2.5rem, 11vw, 5.5rem);
		}

		.why__art {
			--why-art-fade-x: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
			--why-art-fade-y: linear-gradient(
				to bottom,
				transparent,
				#000 6%,
				#000 76%,
				rgb(0 0 0 / 0.8) 85%,
				rgb(0 0 0 / 0.45) 92%,
				rgb(0 0 0 / 0.15) 97%,
				transparent
			);
			width: calc(100% + var(--container-pad));
			max-width: none;
			margin-left: var(--space-2);
			margin-right: calc(var(--container-pad) * -1);
			margin-top: var(--space-5);
		}

		/* Numbered list: equal rows, a hairline only between rows */
		.why-list__item {
			grid-template-columns: 2.5rem minmax(0, 1fr);
			column-gap: var(--space-3);
			padding-block: var(--space-5);
		}

		.why-list__item:first-child {
			padding-top: 0;
		}

		.why-list__item:last-child {
			padding-bottom: 0;
		}

		.why-list__item + .why-list__item {
			border-top: 1px solid rgb(16 17 20 / 0.09);
		}

		.why-list__num {
			font-size: 1.875rem;
		}

		.why-list__body {
			padding-right: var(--why-fab-room); /* text clears the floating buttons; dividers stay full width */
		}

		.why-list__lead {
			margin-bottom: var(--space-2);
			font-size: clamp(1.35rem, 2vw, 1.7rem);
			text-wrap: balance;
		}

		/* Measure sized so each description sets in two lines: wide enough for the
		   longest one to break once, narrow enough that the shortest still wraps. A rem
		   cap (not ch) keeps the line length steady when the font size steps up. */
		.why-list__body p {
			max-width: 28.5rem;
			font-size: 0.9375rem;
			text-wrap: pretty;
		}
	}

	/* Tablet: the photo comes back inside the margins, a larger number column */
	@media (min-width: 640px) and (max-width: 1023.98px) {
		.why__head {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
			align-items: end;
			column-gap: var(--grid-gap);
		}

		.why__intro {
			container-type: inline-size; /* the title sizes itself to this column */
			padding-bottom: var(--space-5);
		}

		/* "Why work with me" on one line. The line is about 6.3em wide, so 15.4% of the
		   column keeps it inside with a little room for the italic overhang. */
		.why__title {
			font-size: min(clamp(2.5rem, 11vw, 5.5rem), 15.4cqi);
			white-space: nowrap;
		}

		.why__title em {
			display: inline;
		}

		.why__art {
			justify-self: end;
			width: 100%;
			max-width: 30rem;
			margin: 0;
		}

		.why-list__item {
			grid-template-columns: 4.5rem minmax(0, 1fr);
			column-gap: var(--space-5);
			padding-block: var(--space-6);
		}

		.why-list__num {
			font-size: 2.75rem;
		}

		.why-list__body p {
			font-size: 1rem;
		}
	}

	@media (min-width: 768px) and (max-width: 1023.98px) {
		.why {
			--why-fab: 3rem;
		}
	}

	/* --- Desktop (1024px and up): the original two-column editorial layout. ---
	   45 / 55 columns split by a faint vertical hairline. Heading at the top left, the
	   photo at the bottom left running into the gutter beside the divider, and the list
	   centred in the right column. Nothing in the phone/tablet block applies here. */
	@media (min-width: 1024px) {
		.why__layout {
			grid-template-columns: minmax(0, 45fr) minmax(0, 55fr);
			gap: 0;
		}

		.why__head {
			display: flex;
			flex-direction: column;
			min-width: 0;
			padding-right: var(--why-gutter);
		}

		.why__intro {
			container-type: inline-size; /* the title sizes itself to this column */
			display: flex;
			flex-direction: column;
			min-width: 0;
		}

		/* "Why work with me" on one line, as large as the column allows (same 15.4%
		   rule as on tablet), never above the original 4.75rem. */
		.why__title {
			margin-top: var(--space-4);
			margin-bottom: var(--space-6);
			font-size: min(clamp(2.75rem, 6vw, 4.75rem), 15.4cqi);
			white-space: nowrap;
		}

		.why__title em {
			display: inline;
		}

		/* The fade is lighter at the sides and the top, and eased at the bottom so the
		   desk dissolves into the ivory without a band. The subject (above 74%) stays
		   fully opaque. */
		.why__art {
			--why-art-fade-x: linear-gradient(to right, transparent, #000 9%, #000 91%, transparent);
			--why-art-fade-y: linear-gradient(
				to bottom,
				transparent,
				#000 6%,
				#000 74%,
				rgb(0 0 0 / 0.94) 80%,
				rgb(0 0 0 / 0.8) 85%,
				rgb(0 0 0 / 0.6) 89.5%,
				rgb(0 0 0 / 0.38) 93.5%,
				rgb(0 0 0 / 0.18) 97%,
				rgb(0 0 0 / 0.05) 99%,
				transparent
			);
			width: calc(100% + 2rem + var(--why-gutter) * 0.85);
			max-width: none;
			margin-top: auto;
			margin-inline: -2rem calc(var(--why-gutter) * -0.85);
			/* Nudged up a little to close some of the space under the title. A relative
			   offset (not transform, which the reveal animation uses; not margin, which
			   would change the layout) moves only the photo. */
			position: relative;
			top: -2.25rem;
		}

		.why-list {
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding-left: var(--why-gutter);
		}

		/* Divider: a single hairline that fades out at both ends */
		.why-list::before {
			content: '';
			position: absolute;
			inset-block: 0;
			left: 0;
			width: 1px;
			background: linear-gradient(to bottom, transparent, var(--rule) 14%, var(--rule) 86%, transparent);
		}

		.why-list__item {
			grid-template-columns: 4.5rem minmax(0, 1fr);
			column-gap: var(--space-5);
			padding-block: clamp(1rem, 2.4vh, 1.5rem);
		}

		.why-list__item + .why-list__item {
			border-top: var(--hairline);
		}

		.why-list__num {
			font-size: 2.625rem;
		}

		/* Same clearance for the floating buttons as on smaller screens. It only matters
		   near 1024px, where the list column is narrow enough to reach them. */
		.why-list__body {
			padding-right: var(--why-fab-room);
		}

		.why-list__lead {
			margin-bottom: 0.375rem;
			font-size: clamp(1.3rem, 1.8vw, 1.55rem);
		}

		.why-list__body p {
			max-width: 44ch;
			font-size: 1rem;
		}
	}

	/* --- Process: vertical line on mobile, horizontal row on desktop ---
	   Sits on the Midnight band (.page-section--midnight). This section is shorter than a screen, so it drops the full-viewport min-height
	   that other sections use and sizes to its content with tighter padding. */
	.process-section {
		min-height: 0;
		padding-block: clamp(3.5rem, 7vw, 5.5rem);
	}

	/* Stacked on small screens: keep the label close to its heading */
	.process-section .section-head {
		row-gap: var(--space-3);
		margin-bottom: var(--space-6);
	}

	.process {
		position: relative;
		display: grid;
		gap: var(--space-5);
	}

	.process::before {
		content: '';
		position: absolute;
		top: 0.5rem;
		bottom: 0;
