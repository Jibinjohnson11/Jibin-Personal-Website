---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Placeholder from '../components/Placeholder.astro';
---

<BaseLayout
	title="Contact Jibin Johnson – Web Developer in Trivandrum"
	description="Have a website, SEO, or Django project? Send a message or WhatsApp. I reply within 24 hours on working days."
	breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }]}
>
	<Container as="section" class="section stack">
		<h1>Contact Jibin Johnson</h1>
		<Placeholder class="lead">Page content coming soon.</Placeholder>
	</Container>
</BaseLayout>
