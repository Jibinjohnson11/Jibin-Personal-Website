---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';
import Rule from '../components/Rule.astro';
import Tag from '../components/Tag.astro';

const colours = [
	{ token: '--paper', light: 'Warm Ivory #FAF6E8', use: 'Page background (60%)' },
	{ token: '--paper-2', light: 'Linen Beige #F1E8DA', use: 'Sections, footer, hover' },
	{ token: '--surface-card', light: 'Ivory White #FEFCF7', use: 'Cards' },
	{ token: '--surface-muted', light: 'Sand Taupe #D8C9B8', use: 'Image wells' },
	{ token: '--ink', light: 'Midnight Black #0B0F14', use: 'Headings, text (30%)' },
	{ token: '--ink-2', light: '#2B3138', use: 'Body copy, secondary text' },
	{ token: '--ink-3', light: 'Stone Grey, darkened #5C6367', use: 'Muted text, captions' },
	{ token: '--label', light: '#5C6367', use: 'Mono labels' },
	{ token: '--accent', light: 'Deep Teal Green #0B5F56', use: 'Links, buttons, accent words (10%)' },
	{ token: '--accent-hover', light: 'Deep Teal #0A3F3A', use: 'Button and link hover' },
	{ token: '--on-accent', light: 'Warm Ivory #FAF6E8', use: 'Text on accent' },
	{ token: '--secondary', light: 'Espresso Brown #4B3621', use: 'Secondary accents' },
	{ token: '--sage', light: 'Sage Green #6B7F6A', use: 'Tags, success' },
	{ token: '--tag-bg', light: 'Sage tint #E3EADC', use: 'Tag background' },
	{ token: '--rule', light: 'Midnight / 14%', use: 'Hairlines' },
	{ token: '--rule-strong', light: 'Stone Grey, darkened #7A7F82', use: 'Field borders (3:1)' },
	{ token: '--positive', light: 'Sage Green #6B7F6A', use: 'Success marker' },
	{ token: '--negative', light: 'Error #EF4444', use: 'Error bars and borders' },
	{ token: '--negative-text', light: '#B42318', use: 'Error text' },
];

const spacing = [
	['--space-1', '4px'],
	['--space-2', '8px'],
	['--space-3', '12px'],
	['--space-4', '16px'],
	['--space-5', '24px'],
	['--space-6', '32px'],
	['--space-7', '48px'],
	['--space-8', '64px'],
	['--space-9', '96px'],
	['--space-10', '144px'],
];
---

<BaseLayout title="Styleguide | Jibin Johnson" description="Design tokens and components for jibinjohnson.in." noindex>
	<div class="sg-header">
		<Container>
			<div class="sg-bar">
				<p class="label">Brand palette / Styleguide</p>
			</div>
		</Container>
	</div>

	<div>
		<Container as="section" class="section">
			<SectionLabel text="Foundation" />
			<h1 class="sg-hero">Websites that <em>get found.</em></h1>
			<p class="lead">
				This page shows every token and component the site is built from.
			</p>
		</Container>

		<Container as="section" class="section sg-section" aria-labelledby="colour">
			<div class="grid">
				<div class="col-label"><SectionLabel text="Colour" /></div>
				<div class="col-content stack">
					<h2 id="colour">Colour</h2>
					<p class="muted small">Every text colour passes WCAG AA on --paper and --paper-2.</p>
					<ul class="sg-swatches" role="list">
						{
							colours.map((c) => (
								<li class="sg-swatch">
									<span class="sg-swatch__chip" style={`background: var(${c.token})`} />
									<code class="label">{c.token}</code>
									<span class="small">{c.use}</span>
									<span class="small muted">{c.light}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</Container>

		<Container as="section" class="section sg-section" aria-labelledby="type">
			<div class="grid">
				<div class="col-label"><SectionLabel text="Type" /></div>
				<div class="col-content">
					<h2 id="type">Type scale</h2>
					<dl class="sg-type">
						<div>
							<dt class="label">Display / Instrument Serif / clamp(2.75rem, 7vw, 6rem)</dt>
							<dd class="display">I build sites people <em>actually find.</em></dd>
						</div>
						<div>
							<dt class="label">H2 / clamp(2rem, 4.5vw, 3.5rem)</dt>
							<dd class="h2">Clean code, <em>clear results.</em></dd>
						</div>
						<div>
							<dt class="label">H3 / clamp(1.375rem, 2.2vw, 1.75rem)</dt>
							<dd class="h3">Technical SEO audits</dd>
						</div>
						<div>
							<dt class="label">Lead / Instrument Sans / clamp(1.125rem, 1.6vw, 1.375rem)</dt>
							<dd class="lead">I'm a web developer and SEO specialist in Trivandrum. I build fast sites and help them show up in search.</dd>
						</div>
						<div>
							<dt class="label">Body / 1.0625rem / 65ch</dt>
							<dd>
								<p>Body copy sits at a comfortable reading size with plenty of line height. It never runs wider than about 65 characters, so long paragraphs stay easy to follow. Here's an <a href="#type">inline link</a> to show the underline style.</p>
							</dd>
						</div>
						<div>
							<dt class="label">Small / 0.875rem</dt>
							<dd class="small muted">Captions, notes and secondary details.</dd>
						</div>
						<div>
							<dt class="label">Label / JetBrains Mono / 0.75rem</dt>
							<dd class="label">Python · Django · Astro</dd>
						</div>
					</dl>
				</div>
			</div>
		</Container>

		<Container as="section" class="section sg-section" aria-labelledby="spacing">
			<div class="grid">
				<div class="col-label"><SectionLabel text="Spacing" /></div>
				<div class="col-content stack">
					<h2 id="spacing">Spacing</h2>
					<ul class="sg-spacing" role="list">
						{
							spacing.map(([token, px]) => (
								<li>
									<code class="label">{token}</code>
									<span class="small muted">{px}</span>
									<span class="sg-spacing__bar" style={`width: var(${token})`} />
								</li>
							))
						}
					</ul>
					<p class="small muted">Section padding clamp(4rem, 10vw, 9rem). Container 1240px max, side padding clamp(1.25rem, 4vw, 3rem). Radius 2px.</p>
				</div>
			</div>
		</Container>

		<Container as="section" class="section sg-section" aria-labelledby="components">
			<div class="grid">
				<div class="col-label"><SectionLabel text="Components" /></div>
				<div class="col-content">
					<h2 id="components">Components</h2>
				</div>
			</div>
			<div class="sg-panels">
				<div class="sg-panel stack">
					<h3>SectionLabel</h3>
					<SectionLabel text="About" />

					<h3>Button</h3>
					<div class="sg-row">
						<Button href="#components">Start a project</Button>
						<Button variant="outline" href="#components">See my work</Button>
						<Button variant="link" href="#components">Read the case study</Button>
					</div>
					<div class="sg-row">
						<Button>Button element</Button>
						<Button variant="outline">Outline button</Button>
						<Button variant="link">Link button</Button>
					</div>

					<h3>Tag</h3>
					<div class="sg-row">
						<Tag>Python</Tag>
						<Tag>Django</Tag>
						<Tag>Astro</Tag>
						<Tag>Technical SEO</Tag>
					</div>

					<h3>Rule</h3>
					<Rule />
					<Rule variant="ink" />

					<h3>Text colours</h3>
					<p>Ink. <span style="color: var(--ink-2)">Ink 2.</span> <span class="muted">Ink 3.</span> <span style="color: var(--accent)">Accent.</span> <span class="label">Label</span></p>
					<p class="sg-on-paper2 small">On paper 2: ink, <span style="color: var(--ink-2)">ink 2</span>, <span class="muted">ink 3</span>, <span style="color: var(--accent)">accent</span>, <span class="label">label</span></p>
				</div>
			</div>
		</Container>

		<Container as="section" class="section sg-section" aria-labelledby="grid">
			<div class="grid">
				<div class="col-label"><SectionLabel text="Grid" /></div>
				<div class="col-content stack">
					<h2 id="grid">12-column grid</h2>
					<p>Labels sit in columns 1 to 3 and content in 4 to 12. Below 768px every column stacks.</p>
				</div>
			</div>
			<div class="grid sg-grid-demo" aria-hidden="true">
				{Array.from({ length: 12 }, (_, i) => <span class="col" style="--span: 1">{i + 1}</span>)}
				<span class="col-label">1 to 3</span>
				<span class="col-content">4 to 12</span>
				<span class="col" style="--start: 1; --span: 7">1 to 7</span>
				<span class="col" style="--start: 8; --span: 5">8 to 12</span>
			</div>
		</Container>
	</div>
</BaseLayout>

<style>
	.sg-header {
		border-bottom: var(--hairline);
	}

	.sg-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding-block: var(--space-3);
	}

	.sg-hero {
		margin-block: var(--space-6) var(--space-5);
	}

	.sg-section {
		position: relative;
	}

	.sg-section::before {
		content: '';
		position: absolute;
		top: 0;
		inset-inline: var(--container-pad);
		border-top: var(--hairline);
	}

	.sg-swatches {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
		gap: var(--space-6) var(--space-5);
	}

	.sg-swatch {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.sg-swatch__chip {
		display: block;
		aspect-ratio: 4 / 3;
		margin-bottom: var(--space-2);
		border: var(--hairline);
		border-radius: var(--radius);
	}

	.sg-type > div {
		padding-block: var(--space-6);
		border-bottom: var(--hairline);
	}

	.sg-type dt {
		margin-bottom: var(--space-3);
	}

	.sg-type dd {
		margin: 0;
	}

	.sg-spacing li {
		display: grid;
		grid-template-columns: 6.5rem 2.5rem minmax(0, 1fr);
		align-items: center;
		gap: var(--space-3);
		padding-block: var(--space-2);
	}

	.sg-spacing__bar {
		display: block;
		height: var(--space-3);
		background: var(--accent);
	}

	.sg-panels {
		display: grid;
		gap: var(--space-5);
		margin-top: var(--space-7);
	}

	.sg-panel {
		--stack-gap: var(--space-4);
		padding: var(--space-6);
		background: var(--paper);
		color: var(--ink);
		border: var(--hairline);
		border-radius: var(--radius);
	}

	.sg-panel h3 {
		margin-top: var(--space-7);
	}

	.sg-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3) var(--space-5);
	}

	.sg-on-paper2 {
		padding: var(--space-4);
		background: var(--paper-2);
	}

	.sg-grid-demo {
		margin-top: var(--space-7);
		gap: var(--space-2) var(--grid-gap);
	}

	.sg-grid-demo > * {
		padding: var(--space-2);
		background: var(--paper-2);
		border: var(--hairline);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		color: var(--ink-2);
		text-align: center;
	}

	@media (max-width: 767px) {
		.sg-grid-demo > .col[style*='--span: 1'] {
			display: none;
		}
	}
</style>
