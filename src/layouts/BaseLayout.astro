---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '../styles/global.css';
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import sansFont from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Preloader from '../components/Preloader.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import Container from '../components/Container.astro';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';
import { ogImageFor } from '../data/og';

interface Props {
	title: string;
	description: string;
	ogImage?: string;
	ogType?: 'website' | 'article' | 'profile';
	noindex?: boolean;
	schema?: Record<string, unknown>[];
	breadcrumbs?: Crumb[];
}

const { title, description, ogImage, ogType, noindex = false, schema, breadcrumbs } = Astro.props;

// Each page gets its own build-time OG image (src/pages/og/[name].png.ts) unless one is passed in.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const og = await ogImageFor(path);
---

<html lang="en-IN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			// Reveal animations hide content only while <html> has .js-reveal. If motion.ts never runs
			// (blocked, failed, very slow network), drop the class so nothing stays hidden.
			(() => {
				if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				const root = document.documentElement;
				root.classList.add('js-reveal');
				setTimeout(() => {
					if (!root.classList.contains('motion-ready')) root.classList.remove('js-reveal');
				}, 3000);

				// Preloader: first page of a session only. Removed after 4s whatever happens.
				try {
					if (sessionStorage.getItem('preloaded')) return;
					sessionStorage.setItem('preloaded', '1');
				} catch {
					return;
				}
				root.classList.add('is-preloading');
				setTimeout(() => {
					if (!root.classList.contains('is-preloading')) return;
					root.classList.remove('is-preloading');
					document.dispatchEvent(new Event('preloader:done'));
				}, 4000);
			})();
		</script>
		<!-- Without JavaScript: plain links instead of the JS-only menu and dropdown. -->
		<noscript>
			<style>
				.menu-button {
					display: none !important;
				}
				.dropdown:hover .dropdown__panel,
				.dropdown:focus-within .dropdown__panel {
					display: block;
				}
				@media (max-width: 767px) {
					.menu-link-nojs {
						display: inline-flex !important;
					}
				}
			</style>
		</noscript>
		<SEO
			title={title}
			description={description}
			ogImage={ogImage ?? og.src}
			ogImageAlt={ogImage ? undefined : og.alt}
			ogType={ogType}
			noindex={noindex}
			schema={schema}
		/>
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<!-- Both text faces up front (Latin only), so headings and body don't swap fonts after first paint. -->
		<link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<Preloader />
		<Header />
		<main id="main" tabindex="-1">
			{
				breadcrumbs && (
					<Container class="breadcrumbs-wrap">
						<Breadcrumbs items={breadcrumbs} />
					</Container>
				)
			}
			<slot />
		</main>
		<Footer />
		<FloatingActions />
		<script>
			import '../scripts/motion';
			import '../scripts/analytics';
		</script>
	</body>
</html>

<style>
	main:focus {
		outline: none;
	}

	main :global(.breadcrumbs-wrap) {
		min-height: var(--crumbs-h);
		padding-top: var(--space-6);
	}
</style>
