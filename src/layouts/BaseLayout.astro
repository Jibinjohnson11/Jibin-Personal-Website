---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '../styles/global.css';
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import Breadcrumbs, { type Crumb } from '../components/Breadcrumbs.astro';

interface Props {
	title: string;
	description: string;
	ogImage?: string;
	noindex?: boolean;
	schema?: Record<string, unknown>[];
	breadcrumbs?: Crumb[];
}

const { title, description, ogImage, noindex = false, schema, breadcrumbs } = Astro.props;
---

<html lang="en-IN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			// Set the theme before first paint to avoid a flash: saved choice first, then the system preference.
			(() => {
				let theme = null;
				try {
					theme = localStorage.getItem('theme');
				} catch {}
				if (theme !== 'light' && theme !== 'dark') {
					theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				document.documentElement.dataset.theme = theme;
			})();
		</script>
		<SEO title={title} description={description} ogImage={ogImage} noindex={noindex} schema={schema} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<Header />
		<main id="main" tabindex="-1">
			{
				breadcrumbs && (
					<Container class="breadcrumbs-wrap">
						<Breadcrumbs items={breadcrumbs} />
					</Container>
				)
			}
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	main:focus {
		outline: none;
	}

	main :global(.breadcrumbs-wrap) {
		padding-top: var(--space-6);
	}
</style>
