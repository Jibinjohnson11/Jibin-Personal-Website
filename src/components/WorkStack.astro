---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Tag from './Tag.astro';

/**
 * Homepage "Selected work": large project cards that stack as you scroll.
 *
 * Each card is position: sticky, so the next one slides up over it (CSS only). The script
 * below adds the depth: cards that have something stacked on top shrink and dim a little.
 * Stacking only switches on when every card fits the viewport, motion is allowed and JS
 * runs; otherwise it's a plain list of cards.
 *
 * Add `cover` to a project's frontmatter to show a screenshot; until then the preview
 * panel shows the project's number, type and year.
 */
interface Props {
	projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol class="stack" role="list" data-stack data-keep-tone style={`--count: ${projects.length}`}>
	{
		projects.map((project, i) => (
			<li class="stack__item" style={`--i: ${i}`} data-stack-item>
				<article class:list={['stack-card', { 'stack-card--flip': i % 2 === 1 }]} data-reveal>
					<div class="stack-card__body">
						<div class="stack-card__meta">
							<span class="label stack-card__num">{pad(i + 1)}</span>
							<span class="label">{project.data.subtitle}</span>
						</div>
						<h3 class="stack-card__title">
							<a class="stack-card__link" href={`/work/${project.id}/`}>
								{project.data.title}
							</a>
						</h3>
						<p class="stack-card__summary">{project.data.homeSummary || project.data.summary}</p>
						<ul class="stack-card__tags" role="list" aria-label="Tools">
							{(project.data.homeTags || project.data.stack).map((tag) => (
								<li>
									<Tag>{tag}</Tag>
								</li>
							))}
						</ul>
						<span class="stack-card__cue label" aria-hidden="true">
							View case study <span class="stack-card__arrow">→</span>
						</span>
					</div>

					<div class="stack-card__media">
						{project.data.cover ? (
							<>
								<Image
									class="stack-card__img"
									src={project.data.cover}
									alt={`${project.data.title} screenshot`}
									widths={[480, 720, 960, 1200]}
									sizes="(min-width: 1024px) 560px, calc(100vw - 2.5rem)"
									loading="lazy"
								/>
								{project.data.coverLabel && <span class="cover-label label">{project.data.coverLabel}</span>}
							</>
						) : (
							<div class="stack-card__plate" aria-hidden="true">
								<span class="stack-card__plate-num">{pad(i + 1)}</span>
								<span class="stack-card__plate-meta label">
									<span>{project.data.type}</span>
									<span>{project.data.year}</span>
								</span>
							</div>
						)}
					</div>
				</article>
			</li>
		))
	}
</ol>

<script>
/* Stacked cards: depth for the cards behind, and the on/off switch for stacking.
   --depth on each card = how many cards are stacked on it, counted continuously
   (0.5 = the next card is half way up). CSS turns it into scale and shade. */
const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)');

document.querySelectorAll<HTMLElement>('[data-stack]').forEach((stack) => {
	const items = [...stack.querySelectorAll<HTMLElement>('[data-stack-item]')];
	const cards = items.map((item) => item.firstElementChild as HTMLElement);
	let stickTops: number[] = [];
	let enabled = false;
	let inView = false;
	let frame = 0;

	const measure = () => {
		stack.classList.add('is-stacking');
		stickTops = items.map((item) => parseFloat(getComputedStyle(item).top) || 0);
		// A card taller than the space under its sticky top would have its lower part hidden
		// behind the next card, so only stack when every card fits.
		const fits = items.every((item, i) => stickTops[i] + item.offsetHeight <= window.innerHeight);
		enabled = motionOk.matches && fits;
		stack.classList.toggle('is-stacking', enabled);
		if (!enabled) cards.forEach((card) => card.style.removeProperty('--depth'));
	};

	const update = () => {
		frame = 0;
		if (!enabled) return;
		// Read every position first, then write, so the browser lays out once.
		const tops = items.map((item) => item.getBoundingClientRect().top);
		const progress = tops.map((top, j) => {
			if (j === 0) return 0;
			// Card j starts covering card j-1 when it reaches that card's bottom edge.
			const start = Math.min(window.innerHeight, stickTops[j - 1] + items[j - 1].offsetHeight);
			const end = stickTops[j];
			return Math.min(1, Math.max(0, (start - top) / (start - end)));
		});
		let depth = 0;
		for (let i = cards.length - 1; i >= 0; i--) {
			cards[i].style.setProperty('--depth', depth.toFixed(3));
			depth += progress[i];
		}
	};

	const schedule = () => {
		if (inView && !frame) frame = requestAnimationFrame(update);
	};

	const refresh = () => {
		measure();
		schedule();
	};

	// Only track scroll while the stack is on screen.
	new IntersectionObserver(([entry]) => {
		inView = entry.isIntersecting;
		schedule();
	}).observe(stack);

	new ResizeObserver(refresh).observe(stack);
	window.addEventListener('scroll', schedule, { passive: true });
	window.addEventListener('resize', refresh, { passive: true });
	motionOk.addEventListener('change', refresh);

	// Tabbing to a card that's buried under others: scroll back to where it sits on its own.
	stack.addEventListener('focusin', (event) => {
		const index = cards.findIndex((card) => card.contains(event.target as Node));
		if (!enabled || index < 0 || parseFloat(cards[index].style.getPropertyValue('--depth')) < 0.5) return;
		const gap = parseFloat(getComputedStyle(stack).rowGap) || 0;
		const naturalTop = stack.getBoundingClientRect().top + window.scrollY + index * (items[0].offsetHeight + gap);
		window.scrollTo({ top: naturalTop - stickTops[index], behavior: 'instant' });
	});

	refresh();
});
</script>

<style>
	.stack {
		--stick-top: calc(var(--header-h) + var(--space-5));
		--peek: 0.75rem; /* how much of each earlier card stays visible above the next */
		--card-radius: 1rem;
		display: grid;
		grid-auto-rows: 1fr; /* equal heights, so no earlier card pokes out underneath */
		gap: var(--space-5);
	}

	.stack__item {
		display: grid; /* lets the card fill the row height */
		grid-template-columns: minmax(0, 1fr);
		margin: 0; /* the gap does the spacing */
	}

	.stack.is-stacking {
		gap: var(--space-8); /* extra scroll between cards so each one has time to settle */
	}

	.stack.is-stacking .stack__item {
		position: sticky;
		top: calc(var(--stick-top) + var(--i) * var(--peek));
		z-index: calc(var(--i) + 1);
	}

	/* --- Card --- */

	/* Deep Teal Green glass: translucent teal over the section's glows, frosted with
	   backdrop blur, a light top edge and an inner highlight. Kept mostly opaque so
	   cards stacked behind don't show through the one on top. */
	.stack-card {
		--depth: 0;
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		background:
			linear-gradient(155deg, rgb(250 246 232 / 0.08), transparent 45%),
			linear-gradient(150deg, rgb(11 95 86 / 0.82), rgb(10 63 58 / 0.9));
		-webkit-backdrop-filter: blur(20px) saturate(140%);
		backdrop-filter: blur(20px) saturate(140%);
		border: 1px solid rgb(181 228 216 / 0.22);
		border-top-color: rgb(250 246 232 / 0.32);
		border-radius: var(--card-radius);
		box-shadow:
			inset 0 1px 0 rgb(250 246 232 / 0.12),
			0 24px 48px -24px rgb(0 0 0 / 0.6);
		overflow: hidden;
		transform-origin: 50% 0;
		/* Cards behind shrink toward their top edge, so their tops stay visible as a stair. */
		scale: calc(1 - min(var(--depth), 3) * 0.04);
	}

	.is-stacking .stack-card {
		box-shadow:
			inset 0 1px 0 rgb(250 246 232 / 0.12),
			0 -12px 32px -16px rgb(0 0 0 / 0.55);
	}

	/* No blur support, or the visitor asked for less transparency: solid teal. */
	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.stack-card {
			background: linear-gradient(150deg, var(--accent), var(--accent-hover));
		}
	}

	@media (prefers-reduced-transparency: reduce) {
		.stack-card {
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
			background: linear-gradient(150deg, var(--accent), var(--accent-hover));
		}
	}

	/* Shade that deepens as more cards stack on top */
	.stack-card::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 2;
		background: #000;
		opacity: calc(min(var(--depth), 2) * 0.12);
		pointer-events: none;
	}

	.stack-card:has(.stack-card__link:focus-visible) {
		outline: 2px solid var(--focus-ring, var(--accent));
		outline-offset: 3px;
	}

	/* Light text tokens on the teal glass. Only the text column flips;
	   the preview plates keep the normal palette for their gradients.
	   Contrast is measured against solid Deep Teal (the lightest the glass gets). */
	.stack-card__body {
		--ink: var(--on-accent); /* Warm Ivory, 7:1 */
		--ink-2: #e6ece4; /* 6.6:1 */
		--label: #c9d6d0; /* 5.4:1 */
		--accent: #b5e4d8; /* light mint, 5.4:1 */
		--accent-hover: #e6f4ef; /* tag text, 6.4:1 on the tag tint */
		--tag-bg: rgb(250 246 232 / 0.1);
		color: var(--ink);
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-5);
	}

	.stack-card__meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
	}

	.stack-card__num {
		color: var(--accent);
	}

	.stack-card__title {
		font-size: clamp(2rem, 4.5vw, 3.5rem);
		line-height: 1.05;
	}

	.stack-card__link {
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
	}

	/* The title link covers the whole card. */
	.stack-card__link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 3;
	}

	.stack-card__link:focus-visible {
		outline: none; /* the card's outline shows instead */
	}

	.stack-card:hover .stack-card__link {
		color: var(--accent);
	}

	.stack-card__summary {
		max-width: 34ch;
		color: var(--ink-2);
	}

	.stack-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.stack-card__cue {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-top: auto;
		padding-top: var(--space-2);
		color: var(--accent);
	}

	.stack-card__arrow {
		transition: translate var(--dur-fast) var(--ease-out);
	}

	.stack-card:hover .stack-card__arrow {
		translate: 4px 0;
	}

	/* --- Preview --- */

	.stack-card__media {
		position: relative;
		outline: 1px solid rgb(250 246 232 / 0.14); /* keeps the teal plate distinct on teal glass */
		outline-offset: -1px;
		order: -1; /* image first on small screens */
		aspect-ratio: 16 / 9;
		background: var(--surface-muted);
	}

	.stack-card__img {
		position: absolute; /* fills the panel without adding its own height to the card */
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center; /* keep the top of a screenshot (logo, nav, headline) */
	}

	.cover-label {
		position: absolute;
		right: var(--space-3);
		bottom: var(--space-3);
		padding: var(--space-1) var(--space-3);
		background: rgb(11 15 20 / 0.72);
		color: var(--on-accent);
		border-radius: 999px;
	}

	.stack-card__plate {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: var(--space-5);
		background:
			var(--grain),
			radial-gradient(120% 90% at 85% 10%, rgb(250 246 232 / 0.12), transparent 60%),
			linear-gradient(150deg, var(--accent), var(--accent-hover));
		color: var(--on-accent);
	}

	.stack-card--flip .stack-card__plate {
		background:
			var(--grain),
			radial-gradient(120% 90% at 15% 10%, rgb(11 95 86 / 0.45), transparent 60%),
			linear-gradient(150deg, #1a2129, var(--ink));
	}

	.stack-card__plate-num {
		align-self: flex-end;
		font-family: var(--font-serif);
		font-size: clamp(4.5rem, 12vw, 9rem);
		line-height: 0.85;
	}

	.stack-card__plate-meta {
		display: flex;
		justify-content: space-between;
		gap: var(--space-4);
		color: inherit;
		opacity: 0.85;
	}

	/* --- Wider screens: two columns, preview side alternates --- */

	@media (min-width: 768px) {
		.stack {
			--stick-top: calc(var(--header-h) + var(--space-6));
			--peek: 1rem;
			--card-radius: 1.25rem;
		}

		.stack-card {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			min-height: min(22rem, 100svh - var(--header-h) - 8rem); /* about 350px */
		}

		.stack-card__body {
			padding: var(--space-6);
		}

		.stack-card__media {
			order: 0;
			aspect-ratio: auto;
			margin: var(--space-3);
			border-radius: calc(var(--card-radius) - var(--space-3));
			overflow: hidden;
		}

		.stack-card--flip .stack-card__media {
			order: -1;
		}
	}

	@media (min-width: 1024px) {
		.stack-card {
			grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		}

		.stack-card--flip {
			grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
		}

		.stack-card__body {
			gap: var(--space-3);
			padding: var(--space-6) var(--space-7);
		}

		.stack-card__cue {
			padding-top: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.stack-card {
			scale: none;
		}

		.stack-card::after {
			display: none;
		}
	}
</style>
