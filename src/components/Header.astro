---
import Container from './Container.astro';
import { SERVICES, SITE, withSlash } from '../data/site';

const path = withSlash(Astro.url.pathname);
const isCurrent = (url: string) => path === url;
const inSection = (url: string) => path.startsWith(url);
const inServices = path.startsWith('/services/');

// Links after the Services dropdown in the desktop nav.
const trailingLinks = [
	{ name: 'About', url: '/about/' },
	{ name: 'Contact', url: '/contact/' },
];
---

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header" data-header>
	<Container class="site-header__inner">
		<a href="/" class="brand" aria-current={isCurrent('/') ? 'page' : undefined}><img class="brand__mark" src="/favicon-96.png" width="96" height="96" alt="" /><span><span class="visually-hidden">{SITE.name[0]}</span>{SITE.name.slice(1)}</span></a>

		<nav class="nav-desktop" aria-label="Main">
			<ul class="nav-desktop__list" role="list">
				<li>
					<a href="/work/" class:list={['nav-link', { 'is-active': inSection('/work/') }]} aria-current={isCurrent('/work/') ? 'page' : undefined}><span class="nav-link__label">Work</span></a>
				</li>
				<li class="dropdown" data-dropdown>
					<button type="button" class:list={['nav-link', 'dropdown__toggle', { 'is-active': inServices }]} aria-expanded="false" aria-controls="services-menu">
						<span class="nav-link__label">Services</span>
						<svg class="dropdown__chevron" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false">
							<path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.25"></path>
						</svg>
					</button>
					<ul id="services-menu" class="dropdown__panel" role="list" hidden>
						<li>
							<a href="/services/" class="dropdown__link" aria-current={isCurrent('/services/') ? 'page' : undefined}>All services</a>
						</li>
						{
							SERVICES.map((service) => (
								<li>
									<a href={service.url} class="dropdown__link" aria-current={isCurrent(service.url) ? 'page' : undefined}>
										{service.name}
									</a>
								</li>
							))
						}
					</ul>
				</li>
				{
					trailingLinks.map((link) => (
						<li>
							<a
								href={link.url}
								class:list={['nav-link', { 'nav-link--cta': link.url === '/contact/', 'is-active': inSection(link.url) }]}
								aria-current={isCurrent(link.url) ? 'page' : undefined}
							>
								{link.url === '/contact/' ? link.name : <span class="nav-link__label">{link.name}</span>}
								{link.url === '/contact/' && <span class="nav-link__arrow" aria-hidden="true" />}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<button type="button" class="menu-button menu-button--icon" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
			<span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
		</button>
		<!-- Shown instead of the button when JavaScript is off (see the <noscript> style in BaseLayout). -->
		<a href="#footer-nav" class="menu-link-nojs">Menu</a>
	</Container>
</header>

<!-- Floating menu button: top right, shown only while scrolling up (see script). -->
<button type="button" class="menu-fab" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-open data-menu-fab>
	<span class="menu-fab__lines" aria-hidden="true"><span></span><span></span><span></span></span>
</button>

<div class="menu-scrim" hidden data-menu-scrim></div>

<div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Site menu" hidden data-menu data-lenis-prevent>
	<Container class="mobile-menu__top">
		<a href="/" class="brand"><img class="brand__mark" src="/favicon-96.png" width="96" height="96" alt="" /><span><span class="visually-hidden">{SITE.name[0]}</span>{SITE.name.slice(1)}</span></a>
		<button type="button" class="menu-button menu-button--close" data-menu-close>Close</button>
	</Container>

	<Container as="nav" class="mobile-menu__nav" aria-label="Mobile">
		<ol class="mobile-menu__list" role="list">
			<li>
				<span class="mobile-menu__num label" aria-hidden="true">01</span>
				<a href="/work/" class="mobile-menu__link" aria-current={isCurrent('/work/') ? 'page' : undefined}>Work</a>
			</li>
			<li>
				<span class="mobile-menu__num label" aria-hidden="true">02</span>
				<span class="mobile-menu__link mobile-menu__link--group" id="mobile-services-heading">Services</span>
				<ul class="mobile-menu__sub" role="list" aria-labelledby="mobile-services-heading">
					<li>
						<a href="/services/" aria-current={isCurrent('/services/') ? 'page' : undefined}>All services</a>
					</li>
					{
						SERVICES.map((service) => (
							<li>
								<a href={service.url} aria-current={isCurrent(service.url) ? 'page' : undefined}>
									{service.name}
								</a>
							</li>
						))
					}
				</ul>
			</li>
			<li>
				<span class="mobile-menu__num label" aria-hidden="true">03</span>
				<a href="/about/" class="mobile-menu__link" aria-current={isCurrent('/about/') ? 'page' : undefined}>About</a>
			</li>
			<li>
				<span class="mobile-menu__num label" aria-hidden="true">04</span>
				<a href="/contact/" class="mobile-menu__link" aria-current={isCurrent('/contact/') ? 'page' : undefined}>Contact</a>
			</li>
		</ol>
	</Container>
</div>

<script>
	/* --- Header and floating menu button: driven by scroll direction, at every size ---
	   Top of the page: the full header, no floating button.
	   Scrolling down: both hidden.
	   Scrolling up: only the floating button (top right). */
	const header = document.querySelector<HTMLElement>('[data-header]');
	const fab = document.querySelector<HTMLElement>('[data-menu-fab]');

	if (header) {
		// A direction only counts after this much travel, so trackpad jitter and
		// small touch wobbles don't flicker the button.
		const DIRECTION_THRESHOLD = 8;
		let ticking = false;
		let lastY = window.scrollY;
		let fabShown = false;

		const update = () => {
			// Clamp so iOS rubber-band overscroll at either end isn't read as a direction change.
			const maxY = Math.max(document.documentElement.scrollHeight - window.innerHeight, 0);
			const y = Math.min(Math.max(window.scrollY, 0), maxY);
			// "Top" is the header's own height: within it the header is still in place.
			const atTop = y <= header.offsetHeight;
			const delta = y - lastY;

			if (atTop) {
				fabShown = false;
				lastY = y;
			} else if (Math.abs(delta) >= DIRECTION_THRESHOLD) {
				fabShown = delta < 0;
				lastY = y;
			}

			// Keep the header in view while a keyboard user is tabbing through it.
			const keepHeader = header.contains(document.activeElement);
			header.classList.toggle('is-scrolled', y > 4);
			header.classList.toggle('is-hidden', !atTop && !keepHeader);
			fab?.classList.toggle('is-visible', fabShown);

			ticking = false;
		};

		const requestUpdate = () => {
			if (!ticking) {
				requestAnimationFrame(update);
				ticking = true;
			}
		};

		window.addEventListener('scroll', requestUpdate, { passive: true });
		window.addEventListener('resize', requestUpdate, { passive: true });
		header.addEventListener('focusin', () => header.classList.remove('is-hidden'));
		header.addEventListener('focusout', requestUpdate);
		update();
	}

	/* --- Services dropdown (disclosure) ----------------------------------- */
	document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dropdown) => {
		const toggle = dropdown.querySelector<HTMLButtonElement>('.dropdown__toggle');
		const panel = dropdown.querySelector<HTMLElement>('.dropdown__panel');
		if (!toggle || !panel) return;

		const setOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			panel.hidden = !open;
		};

		toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

		// Listen on the document so Escape works even if a mouse click didn't move focus (Safari).
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !panel.hidden) {
				setOpen(false);
				toggle.focus();
			}
		});

		// Close when focus moves out of the dropdown (e.g. tabbing past the last link).
		dropdown.addEventListener('focusout', (event) => {
			if (!dropdown.contains(event.relatedTarget as Node | null)) setOpen(false);
		});

		document.addEventListener('click', (event) => {
			if (!dropdown.contains(event.target as Node)) setOpen(false);
		});
	});

	/* --- Menu overlay: opened by the header's Menu button (mobile) or the floating button --- */
	const root = document.documentElement;
	const menu = document.querySelector<HTMLElement>('[data-menu]');
	const scrim = document.querySelector<HTMLElement>('[data-menu-scrim]');
	const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-menu-open]');
	const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');

	if (menu && closeButton && openButtons.length) {
		let trigger: HTMLElement | null = null;

		// On mobile the floating button sits over the menu's Close button, which is then
		// hidden (see CSS). The floating button takes its place in the focus loop.
		const closeShown = () => closeButton.getClientRects().length > 0;

		const focusables = () => {
			const items = Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter((el) => el.offsetParent !== null);
			return trigger?.hasAttribute('data-menu-fab') && !closeShown() ? [trigger, ...items] : items;
		};

		const setExpanded = (open: boolean) =>
			openButtons.forEach((button) => {
				button.setAttribute('aria-expanded', String(open));
				if (button.hasAttribute('data-menu-fab')) button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			});

		const onKeydown = (event: KeyboardEvent) => {
			if (event.key === 'Escape') {
				closeMenu();
				return;
			}
			if (event.key !== 'Tab') return;

			const items = focusables();
			const first = items[0];
			const last = items[items.length - 1];
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		};

		function openMenu(event: Event) {
			trigger = event.currentTarget as HTMLElement;
			menu!.hidden = false;
			if (scrim) scrim.hidden = false;
			void menu!.offsetWidth; // paint the closed state first so the slide-in runs
			root.classList.add('menu-open');
			root.classList.toggle('menu-from-fab', trigger.hasAttribute('data-menu-fab'));
			setExpanded(true);
			document.addEventListener('keydown', onKeydown);
			(closeShown() ? closeButton! : trigger).focus();
		}

		function closeMenu() {
			if (!root.classList.contains('menu-open')) return;
			root.classList.remove('menu-open', 'menu-from-fab');
			setExpanded(false);
			document.removeEventListener('keydown', onKeydown);
			// Hide once the slide-out has finished (unless it was reopened meanwhile).
			setTimeout(() => {
				if (root.classList.contains('menu-open')) return;
				menu!.hidden = true;
				if (scrim) scrim.hidden = true;
			}, 600);
			// Back to whichever button opened it, if it's still on screen
			if (trigger && trigger.getClientRects().length > 0) trigger.focus();
		}

		// The floating button stays above the open menu, so it toggles: open, then close.
		openButtons.forEach((button) =>
			button.addEventListener('click', (event) => (root.classList.contains('menu-open') ? closeMenu() : openMenu(event))),
		);
		closeButton.addEventListener('click', closeMenu);
		scrim?.addEventListener('click', closeMenu);
	}
</script>

<style>
	.skip-link {
		position: absolute;
		top: var(--space-3);
		left: var(--space-3);
		z-index: 100;
		padding: var(--space-3) var(--space-4);
		background: var(--accent);
		color: var(--on-accent);
		font-size: var(--text-small);
		text-decoration: none;
		border-radius: var(--radius);
		transform: translateY(-200%);
	}

	.skip-link:focus-visible {
		transform: none;
		color: var(--on-accent);
	}

	/* The header keeps its 4.5rem (--header-h) footprint: 0.625rem above and below a
	   3.25rem floating bar. The bar is an ivory pill drawn behind the content by ::before,
	   inset a little from the container edges so it floats clear of the screen sides. */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		padding-block: 0.625rem;
		transition: transform var(--dur-base) var(--ease-out);
	}

	.site-header.is-hidden {
		transform: translateY(calc(-100% - var(--space-2)));
	}

	.site-header :global(.site-header__inner) {
		position: relative;
		isolation: isolate;
		display: flex;
		align-items: center;
		gap: var(--space-4);
		min-height: 3.25rem;
	}

	/* Resting: near-solid ivory, a 1px warm hairline and a soft, wide ambient shadow */
	.site-header :global(.site-header__inner)::before {
		content: '';
		position: absolute;
		inset-block: 0;
		inset-inline: max(var(--space-2), calc(var(--container-pad) - var(--space-4)));
		z-index: -1;
		border: 1px solid rgb(216 201 184 / 0.6);
		border-radius: 999px;
		background: rgb(250 246 232 / 0.94);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.7),
			0 1px 2px rgb(75 54 33 / 0.04),
			0 12px 32px -20px rgb(75 54 33 / 0.22);
		transition:
			background-color var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out),
			border-color var(--dur-base) var(--ease-out),
			backdrop-filter var(--dur-base) var(--ease-out),
			-webkit-backdrop-filter var(--dur-base) var(--ease-out);
	}

	/* Scrolled: a touch more translucent with a light blur, and lifted a little */
	.site-header.is-scrolled :global(.site-header__inner)::before {
		border-color: rgb(216 201 184 / 0.75);
		background: rgb(250 246 232 / 0.8);
		-webkit-backdrop-filter: blur(10px) saturate(1.15);
		backdrop-filter: blur(10px) saturate(1.15);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.7),
			0 2px 6px rgb(75 54 33 / 0.05),
			0 18px 40px -22px rgb(75 54 33 / 0.32);
	}

	/* Mobile and tablet (below the desktop nav breakpoint): no floating pill.
	   The bar runs edge to edge on plain warm ivory, logo left, hamburger right. */
	/* The header also isn't sticky here: it sits at the top of the page and scrolls away
	   with it. The floating teal button (.menu-fab) takes over once it's gone. */
	@media (max-width: 767px) {
		.site-header {
			position: relative;
			background: var(--paper);
		}

		.site-header.is-hidden {
			transform: none;
		}

		.site-header :global(.site-header__inner) {
			justify-content: space-between;
		}

		.site-header :global(.site-header__inner)::before {
			content: none;
		}
	}

	.brand {
		display: inline-flex;
		align-items: baseline;
		margin-right: auto;
		font-family: var(--font-serif);
		font-size: 1.375rem;
		line-height: 1;
		letter-spacing: -0.005em;
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
	}

	.brand:hover {
		color: var(--ink);
	}

	.brand:focus-visible {
		outline-offset: 6px;
		border-radius: 6px;
	}

	/* The J of "Jibin": the favicon monogram, sized to the serif's capital J
	   (cap height plus its small descender), followed by "ibin Johnson".
	   On hover the monogram tilts slightly, like a stamp being picked up. */
	.brand__mark {
		display: inline-block;
		width: auto;
		height: 0.95em;
		margin-right: 0.04em;
		align-self: center;
		transform: translateY(0.02em);
		border-radius: 0.2em;
		box-shadow: 0 2px 6px -3px rgb(11 95 86 / 0);
		transition:
			transform var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out);
	}

	.brand:hover .brand__mark {
		transform: translateY(-0.04em) rotate(-6deg);
		box-shadow: 0 4px 10px -4px rgb(11 95 86 / 0.45);
	}

	/* Desktop nav */
	.nav-desktop {
		display: none;
	}

	.nav-desktop__list {
		display: flex;
		align-items: center;
		gap: var(--space-1);
	}

	/* Text links with a thin teal underline that draws in from the left on hover
	   and leaves to the right. The current section keeps its underline. */
	.nav-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		min-height: 2.5rem;
		padding: 0 var(--space-3);
		border: 0;
		border-radius: 999px;
		background: transparent;
		font-size: var(--text-small);
		font-weight: 500;
		letter-spacing: 0.01em;
		color: var(--ink-2);
		text-decoration: none;
		cursor: pointer;
		transition:
			color var(--dur-base) var(--ease-out),
			background-color var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out);
	}

	.nav-link__label {
		position: relative;
		display: inline-block;
	}

	.nav-link__label::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.3rem;
		height: 1px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: right center;
		transition: transform var(--dur-base) var(--ease-out);
	}

	.nav-link:hover,
	.nav-link:focus-visible,
	.dropdown__toggle[aria-expanded='true'] {
		color: var(--ink);
	}

	.nav-link:hover .nav-link__label::after,
	.nav-link:focus-visible .nav-link__label::after,
	.dropdown__toggle[aria-expanded='true'] .nav-link__label::after,
	.nav-link[aria-current='page'] .nav-link__label::after,
	.nav-link.is-active .nav-link__label::after {
		transform: scaleX(1);
		transform-origin: left center;
	}

	.nav-link[aria-current='page'],
	.nav-link.is-active {
		color: var(--accent);
	}

	.nav-link:focus-visible {
		border-radius: 999px;
	}

	/* Contact: the one solid call to action in the bar, in deep teal */
	.nav-link--cta {
		gap: 0.45rem;
		min-height: 2.375rem;
		margin-left: var(--space-3);
		padding-inline: var(--space-4) 0.875rem;
		background: var(--accent);
		color: var(--on-accent);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.14),
			0 6px 16px -10px rgb(11 95 86 / 0.7);
	}

	.nav-link--cta:hover,
	.nav-link--cta:focus-visible,
	.nav-link--cta[aria-current='page'],
	.nav-link--cta.is-active {
		background: var(--accent-hover);
		color: var(--on-accent);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.12),
			0 10px 22px -10px rgb(11 95 86 / 0.75);
	}

	/* The arrow slides out to the right while a second one slides in from the left */
	.nav-link__arrow {
		position: relative;
		display: inline-block;
		width: 1em;
		height: 1.2em;
		overflow: hidden;
	}

	.nav-link__arrow::before,
	.nav-link__arrow::after {
		content: '\2192';
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		line-height: 1;
		transition: transform var(--dur-base) var(--ease-out);
	}

	.nav-link__arrow::after {
		transform: translateX(-120%);
	}

	.nav-link--cta:hover .nav-link__arrow::before,
	.nav-link--cta:focus-visible .nav-link__arrow::before {
		transform: translateX(120%);
	}

	.nav-link--cta:hover .nav-link__arrow::after,
	.nav-link--cta:focus-visible .nav-link__arrow::after {
		transform: none;
	}

	.dropdown {
		position: relative;
	}

	.dropdown__chevron {
		opacity: 0.7;
		transition:
			transform var(--dur-base) var(--ease-out),
			opacity var(--dur-base) var(--ease-out);
	}

	.dropdown__toggle:hover .dropdown__chevron {
		opacity: 1;
		transform: translateY(1px);
	}

	.dropdown__toggle[aria-expanded='true'] .dropdown__chevron {
		transform: rotate(180deg);
	}

	.dropdown__panel {
		position: absolute;
		top: calc(100% + var(--space-3));
		left: calc(var(--space-2) * -1);
		min-width: 16rem;
		padding: var(--space-2);
		border: 1px solid rgb(11 15 20 / 0.08);
		border-radius: 18px;
		background: rgb(254 252 247 / 0.94);
		-webkit-backdrop-filter: blur(16px) saturate(1.4);
		backdrop-filter: blur(16px) saturate(1.4);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.8),
			0 24px 48px -24px rgb(11 15 20 / 0.4);
		transform-origin: top left;
		animation: dropdown-in 220ms var(--ease-out);
	}

	@keyframes dropdown-in {
		from {
			opacity: 0;
			transform: translateY(-6px) scale(0.98);
		}
	}

	.dropdown__link {
		display: block;
		padding: 0.625rem var(--space-4);
		border-radius: 12px;
		font-size: var(--text-small);
		color: var(--ink-2);
		text-decoration: none;
		transition:
			background-color var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}

	.dropdown__link:hover {
		background: var(--paper-2);
		color: var(--ink);
	}

	.dropdown__link:focus-visible {
		border-radius: 12px;
	}

	.dropdown__link[aria-current='page'] {
		color: var(--accent);
		background: rgb(11 95 86 / 0.08);
	}

	.menu-button {
		min-width: 3rem;
		min-height: 2.5rem;
		padding: 0 var(--space-4);
		border: 1px solid rgb(11 15 20 / 0.12);
		border-radius: 999px;
		background: rgb(255 255 255 / 0.45);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink);
		cursor: pointer;
		transition:
			background-color var(--dur-fast) var(--ease-out),
