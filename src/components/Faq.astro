---
/**
 * Accordion of questions. Pass the same items to FAQPage schema so the markup and
 * the structured data always match word for word.
 */
export interface FaqItem {
	q: string;
	a: string;
}

interface Props {
	items: FaqItem[];
	/** Start with the first question open (used on the homepage). */
	openFirst?: boolean;
}

const { items, openFirst = false } = Astro.props;
---

<div class="faq-list" data-reveal>
	{
		items.map((faq, i) => (
			<details class="faq" open={openFirst && i === 0}>
				<summary>
					<h3 class="faq__q">{faq.q}</h3>
					<span class="faq__icon" aria-hidden="true" />
				</summary>
				<div class="faq__a">
					<p>{faq.a}</p>
				</div>
			</details>
		))
	}
</div>

<style>
	/* Editorial accordion: no boxes or backgrounds, only hairlines between questions.
	   The open question turns teal and gets a short vertical teal line on its left. */
	.faq-list {
		--faq-indent: clamp(0.875rem, 1.6vw, 1.25rem); /* room for the accent line */
	}

	.faq {
		position: relative;
		border-bottom: var(--hairline);
	}

	.faq:first-child {
		border-top: var(--hairline);
	}

	/* Active accent: draws down from the top when the question opens */
	.faq::before {
		content: '';
		position: absolute;
		top: clamp(0.875rem, 1.4vw, 1.125rem);
		bottom: clamp(1rem, 1.6vw, 1.25rem);
		left: 0;
		width: 2px;
		background: var(--accent);
		transform: scaleY(0);
		transform-origin: top;
		transition: transform var(--dur-base) var(--ease-out);
	}

	.faq[open]::before {
		transform: scaleY(1);
	}

	.faq summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: clamp(0.875rem, 1.4vw, 1.125rem);
		padding-left: var(--faq-indent);
		cursor: pointer;
		list-style: none;
	}

	.faq summary::-webkit-details-marker {
		display: none;
	}

	.faq__q {
		font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
		line-height: 1.25;
		transition: color var(--dur-fast) var(--ease-out);
	}

	.faq summary:hover .faq__q,
	.faq[open] .faq__q {
		color: var(--accent);
	}

	/* Teal "+" drawn with two lines. When open, the vertical line folds away and
	   leaves a "−". */
	.faq__icon {
		position: relative;
		flex: none;
		width: 0.875rem;
		height: 0.875rem;
		color: var(--accent);
	}

	.faq__icon::before,
	.faq__icon::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 0;
		width: 100%;
		height: 1.5px;
		margin-top: -0.75px;
		background: currentColor;
		transition: transform var(--dur-base) var(--ease-out);
	}

	.faq__icon::after {
		transform: rotate(90deg);
	}

	.faq[open] .faq__icon::after {
		transform: rotate(90deg) scaleX(0);
	}

	.faq__a {
		padding-bottom: clamp(1rem, 1.6vw, 1.25rem);
		padding-left: var(--faq-indent);
		padding-right: calc(0.875rem + var(--space-4)); /* answer stops short of the icon column */
		color: var(--ink-2);
	}

	.faq__a p {
		max-width: 62ch;
		margin-top: calc(var(--space-2) * -1); /* answer sits close to its question */
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	@media (min-width: 768px) {
		.faq__a p {
			font-size: 1rem;
		}
	}
</style>
