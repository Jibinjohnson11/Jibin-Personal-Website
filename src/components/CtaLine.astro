---
import Button from './Button.astro';
---

<!-- Quiet one-line call to action: serif sentence and a link button. -->
<div class="cta-line" data-reveal>
	<p class="cta-line__text">Like what you see? <em>Let's build yours.</em></p>
	<Button variant="link" href="/contact/">Start a project</Button>
</div>

<style>
	.cta-line {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-3) var(--space-6);
		margin-top: var(--space-7);
	}

	.cta-line__text {
		font-family: var(--font-serif);
		font-size: var(--text-h3);
		line-height: 1.2;
	}

	.cta-line__text em {
		color: var(--accent);
	}
</style>
