---
import type { HTMLAttributes } from 'astro/types';

type Props = {
	variant?: 'primary' | 'outline' | 'link';
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	class?: string;
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'type' | 'class'>;

const { variant = 'primary', href, type = 'button', class: className, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, className];
---

{
	href ? (
		<a href={href} class:list={classes} {...rest}>
			<span class="btn__text"><slot /></span>
			{variant === 'link' && <span class="btn__arrow" aria-hidden="true">→</span>}
		</a>
	) : (
		<button type={type} class:list={classes} {...rest}>
			<span class="btn__text"><slot /></span>
			{variant === 'link' && <span class="btn__arrow" aria-hidden="true">→</span>}
		</button>
	)
}

<style>
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		font-family: var(--font-sans);
		font-size: var(--text-small);
		font-weight: 500;
		line-height: 1;
		letter-spacing: 0.01em;
		text-decoration: none;
		border-radius: var(--radius);
		transition:
			background-color var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}

	.btn--primary,
	.btn--outline {
		min-height: 3rem;
		padding: var(--space-4) var(--space-5);
		border: 1px solid var(--accent);
		border-radius: var(--btn-radius);
	}

	/* Keep the rounded shape when focused (the global focus style resets the radius) */
	.btn--primary:focus-visible,
	.btn--outline:focus-visible {
		border-radius: var(--btn-radius);
	}

	.btn--outline {
		border-color: var(--ink);
	}

	.btn--primary {
		background: var(--accent);
		color: var(--on-accent);
	}

	.btn--primary:hover,
	.btn--primary:active {
		background: var(--accent-hover);
		border-color: var(--accent-hover);
		color: var(--on-accent);
	}

	.btn--outline {
		background: transparent;
		color: var(--ink);
	}

	.btn--outline:hover,
	.btn--outline:active {
		background: var(--ink);
		color: var(--paper);
	}

	.btn:disabled,
	.btn[aria-disabled='true'] {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.btn--primary:disabled:hover {
		background: var(--accent);
		border-color: var(--accent);
	}

	.btn--outline:disabled:hover {
		background: transparent;
		color: var(--ink);
	}

	/* Link: text with animated underline and a shifting arrow */
	.btn--link {
		padding: var(--space-1) 0;
		border: 0;
		background: none;
		color: var(--accent);
	}

	.btn--link .btn__text {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.3em;
		transition:
			text-decoration-thickness var(--dur-base) var(--ease-out),
			text-underline-offset var(--dur-base) var(--ease-out);
	}

	.btn--link:hover {
		color: var(--accent-hover);
	}

	.btn--link:hover .btn__text {
		text-decoration-thickness: 2px;
		text-underline-offset: 0.2em;
	}

	.btn__arrow {
		display: inline-block;
		transition: transform var(--dur-base) var(--ease-out);
	}

	.btn--link:hover .btn__arrow {
		transform: translateX(4px);
	}

	@media (prefers-reduced-motion: reduce) {
		.btn--link:hover .btn__arrow {
			transform: none;
		}
	}
</style>
