---
/**
 * First-visit preloader: a quiet ivory screen with the name, a counter and a hairline
 * emerald progress line, which fades into the page once the first screen is ready.
 *
 * Only shows while <html> has .is-preloading. The inline script in BaseLayout adds it
 * on the first page of a session (never for reduced motion) and drops it after 4s as a
 * safety net, so without JavaScript or on later pages this stays display: none.
 * When it starts to fade it fires "preloader:done" so motion.ts can start the reveals.
 *
 * "Ready" means what the first screen needs: the web fonts and the above-the-fold image
 * marked fetchpriority="high". It doesn't wait for every lazy image on the page.
 */
---

<div class="preloader" aria-hidden="true" data-preloader>
	<div class="preloader__inner">
		<p class="preloader__label">Web developer · SEO · Thiruvananthapuram</p>
		<p class="preloader__name">
			<span class="preloader__word"><span>Jibin</span></span>
			<span class="preloader__word"><em>Johnson</em></span>
		</p>
		<div class="preloader__foot">
			<span class="preloader__status"><span class="preloader__dot"></span>Loading</span>
			<span class="preloader__count" data-preloader-count>000</span>
		</div>
		<span class="preloader__bar"><span data-preloader-bar></span></span>
	</div>
</div>

<script>
	const root = document.documentElement;
	const el = document.querySelector<HTMLElement>('[data-preloader]');

	if (el && root.classList.contains('is-preloading')) {
		const count = el.querySelector<HTMLElement>('[data-preloader-count]');
		const bar = el.querySelector<HTMLElement>('[data-preloader-bar]');
		const MIN = 900; // long enough for the name to settle, short enough not to annoy
		const MAX = 2600; // never wait longer than this on a slow connection

		// Critical assets: web fonts, plus the priority hero image if the page has one.
		const settle = (p: Promise<unknown>) => p.then(() => true, () => true);
		const hero = document.querySelector<HTMLImageElement>('img[fetchpriority="high"]');
		const heroReady = hero
			? hero.complete
				? Promise.resolve()
				: new Promise<void>((resolve) => {
						hero.addEventListener('load', () => resolve(), { once: true });
						hero.addEventListener('error', () => resolve(), { once: true });
					}).then(() => hero.decode?.())
			: Promise.resolve();
		let ready = false;
		Promise.all([settle(document.fonts?.ready ?? Promise.resolve()), settle(heroReady)]).then(() => (ready = true));

		const start = performance.now();
		let value = 0;
		let leaving = false;

		const remove = () => {
			if (el.isConnected) el.remove();
		};

		const finish = () => {
			if (leaving) return;
			leaving = true;
			el.classList.add('is-leaving');
			root.classList.remove('is-preloading');
			document.dispatchEvent(new Event('preloader:done'));
			// Only the overlay's own fade ends it; transitions on the content inside bubble up too.
			el.addEventListener('transitionend', (event) => event.target === el && event.propertyName === 'opacity' && remove());
			setTimeout(remove, 1400);
		};

		// Ease towards 90 while the assets load, then run up to 100.
		const tick = (now: number) => {
			// The 4s fallback in BaseLayout already hid it (e.g. frames paused in a background tab)
			if (!root.classList.contains('is-preloading')) return remove();

			const t = now - start;
			const done = (ready && t >= MIN) || t >= MAX;
			const target = done ? 100 : Math.min(90, (t / MIN) * 90);
			value += (target - value) * (done ? 0.2 : 0.1);
			if (done && value > 99.5) value = 100;

			if (count) count.textContent = String(Math.round(value)).padStart(3, '0');
			if (bar) bar.style.transform = `scaleX(${value / 100})`;

			if (value === 100) setTimeout(finish, 120);
			else requestAnimationFrame(tick);
		};

		requestAnimationFrame(tick);
	}
</script>

<style>
	.preloader {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: none;
		color: var(--ink);
		background: var(--grain), var(--paper);
		opacity: 1;
		transition: opacity 700ms var(--ease-out) 120ms;
	}

	:global(.is-preloading) .preloader,
	.preloader.is-leaving {
		display: block;
	}

	/* The page underneath is the same ivory, so a plain fade reads as one surface. */
	.preloader.is-leaving {
		opacity: 0;
		pointer-events: none;
	}

	.preloader__inner {
		display: grid;
		grid-template-rows: auto 1fr auto;
		height: 100%;
		max-width: var(--container-max);
		margin-inline: auto;
		padding: var(--space-6) var(--container-pad) var(--space-7);
		animation: preloader-in 600ms var(--ease-out) backwards; /* backwards: never fights the exit fade */
		transition:
			opacity 450ms var(--ease-out),
			transform 700ms var(--ease-out);
	}

	.preloader.is-leaving .preloader__inner {
		opacity: 0;
		transform: translateY(-1.5rem);
	}

	.preloader__label,
	.preloader__foot {
		font-family: var(--font-mono);
		font-size: var(--text-label);
		line-height: 1.4;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-3);
	}

	.preloader__label {
		max-width: none;
	}

	.preloader__name {
		align-self: center;
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.25em;
		max-width: none;
		font-family: var(--font-serif);
		font-size: clamp(3.25rem, 12vw, 9rem);
		line-height: 1;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.preloader__name em {
		font-style: italic;
		color: var(--accent);
	}

	/* Each word rises out of its own line */
	.preloader__word {
		display: inline-block;
		overflow: hidden;
		/* room for the J's descender and the italic overhang inside the mask */
		padding: 0 0.08em 0.22em 0;
		margin-bottom: -0.22em;
	}

	.preloader__word > * {
		display: inline-block;
		animation: preloader-rise 1s var(--ease-out) both;
	}

	.preloader__word + .preloader__word > * {
		animation-delay: 120ms;
	}

	.preloader__foot {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: var(--space-4);
	}

	.preloader__status {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
	}

	/* A single emerald dot that breathes while loading */
	.preloader__dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
		animation: preloader-pulse 1.4s ease-in-out infinite;
	}

	.preloader__count {
		font-size: clamp(1rem, 2.5vw, 1.5rem);
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}

	.preloader__bar {
		display: block;
		height: 1px;
		background: var(--rule);
	}

	.preloader__bar > span {
		display: block;
		height: 100%;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
	}

	@keyframes preloader-in {
		from {
			opacity: 0;
		}
	}

	@keyframes preloader-rise {
		from {
			transform: translateY(105%);
		}
	}

	@keyframes preloader-pulse {
		50% {
			opacity: 0.25;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.preloader {
			display: none !important;
		}
	}
</style>
