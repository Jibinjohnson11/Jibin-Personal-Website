---
import { Image } from 'astro:assets';
import Tag from './Tag.astro';
import type { WorkCard } from '../data/work-extra';

interface Props {
	cards: WorkCard[];
}

const { cards } = Astro.props;
---

<!-- /work/ project grid: 3 columns on desktop, 2 on tablet, 1 on mobile. A card with an href links
     to its case study as a whole; no scroll animation, hover effects only on devices that can hover. -->
<ul class="showcase" role="list">
	{
		cards.map((card, i) => (
			<li class:list={['card', { 'card--link': card.href }]}>
				<div class="card__media">
					{card.cover ? (
						<Image
							class="card__img"
							src={card.cover}
							alt={card.coverAlt ?? `${card.title}, ${card.subtitle}`}
							widths={[400, 600, 800]}
							sizes="(min-width: 1024px) 380px, (min-width: 640px) 46vw, 92vw"
							loading={i < 3 ? 'eager' : 'lazy'}
							style={card.coverPosition ? `object-position: ${card.coverPosition}` : undefined}
						/>
					) : (
						<div class="card__img card__img--empty">
							<span class="label">[PLACEHOLDER] Screenshot</span>
						</div>
					)}
					{card.coverLabel && <span class="card__cover-label label">{card.coverLabel}</span>}
				</div>

				<div class="card__content">
					<div class="card__head">
						<h2 class="card__title">
							{card.href ? (
								<a class="card__link" href={card.href}>
									{card.title}
								</a>
							) : (
								card.title
							)}
						</h2>
						{card.href && (
							<span class="card__arrow" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
									<path d="M5 12h13M13 7l5 5-5 5" />
								</svg>
							</span>
						)}
					</div>
					<p class="card__category label">{card.subtitle}</p>
					<p class="card__summary">{card.summary}</p>
					<ul class="card__tags" role="list" aria-label="Tools">
						{card.stack.map((tag) => (
							<li>
								<Tag>{tag}</Tag>
							</li>
						))}
					</ul>
				</div>
			</li>
		))
	}
</ul>

<style>
	.showcase {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-5);
	}

	@media (min-width: 640px) {
		.showcase {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.showcase {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--space-6);
		}
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: var(--space-3);
		background: var(--surface-card);
		border: var(--hairline);
		border-radius: 20px;
		transition: border-color var(--dur-base) var(--ease-out);
	}

	.card__media {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		border-radius: 14px;
		background: var(--surface-muted);
	}

	.card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		transition: transform var(--dur-base) var(--ease-out);
	}

	.card__img--empty {
		display: grid;
		place-items: center;
		background: var(--paper-2);
	}

	.card__cover-label {
		position: absolute;
		left: var(--space-3);
		bottom: var(--space-3);
		padding: 0.125rem var(--space-2);
		border-radius: var(--radius);
		background: rgb(250 246 232 / 0.92);
		color: var(--ink);
	}

	.card__content {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: var(--space-5) var(--space-3) var(--space-3);
	}

	.card__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-3);
	}

	.card__title {
		font-size: clamp(1.625rem, 2.4vw, 2.125rem);
		font-weight: 400;
		line-height: 1.1;
	}

	.card__link {
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
	}

	/* Stretch the link over the whole card. */
	.card__link::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 20px;
	}

	.card__link:focus-visible {
		outline: none;
	}

	.card:has(.card__link:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.card__arrow {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		margin-top: 0.125rem;
		border: 1px solid var(--accent);
		border-radius: 50%;
		color: var(--accent);
	}

	.card__arrow svg {
		transition: transform var(--dur-base) var(--ease-out);
	}

	.card__category {
		margin-top: var(--space-2);
	}

	.card__summary {
		margin-top: var(--space-4);
		color: var(--ink-2);
		font-size: 1rem;
	}

	/* Tags sit at the bottom so cards in a row line up. */
	.card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: auto;
		padding-top: var(--space-5);
	}

	@media (hover: hover) and (pointer: fine) {
		.card--link:hover {
			border-color: var(--accent);
		}

		.card--link:hover .card__link {
			color: var(--accent);
		}

		.card--link:hover .card__img {
			transform: scale(1.02);
		}

		.card--link:hover .card__arrow svg {
			transform: translateX(3px);
		}
	}

	.card:has(.card__link:focus-visible) .card__link {
		color: var(--accent);
	}
</style>
