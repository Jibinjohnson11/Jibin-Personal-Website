---
import { Image } from 'astro:assets';
import type { WorkCard } from '../data/work-extra';

interface Props {
	cards: WorkCard[];
}

const { cards } = Astro.props;
---

<!-- /work/ project grid: deep teal cards with a screenshot, title, category and arrow.
     3 columns on desktop, 2 on tablet, 1 on mobile. A card with an href links as a whole. -->
<ul class="showcase" role="list">
	{
		cards.map((card, i) => (
			<li class:list={['card', { 'card--link': card.href }]}>
				<div class="card__media">
					{card.cover && (
						<Image
							class="card__img"
							src={card.cover}
							alt={card.coverAlt ?? `${card.title}, ${card.subtitle}`}
							widths={[400, 600, 800]}
							sizes="(min-width: 1024px) 380px, (min-width: 640px) 46vw, 92vw"
							loading={i < 3 ? 'eager' : 'lazy'}
							style={card.coverPosition ? `object-position: ${card.coverPosition}` : undefined}
						/>
					)}
				</div>

				<div class="card__foot">
					<div>
						<h2 class="card__title">
							{card.href ? (
								<a class="card__link" href={card.href}>
									{card.title}
								</a>
							) : (
								card.title
							)}
						</h2>
						<p class="card__category label">{card.subtitle}</p>
					</div>
					{card.href && (
						<span class="card__arrow" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M5 12h13M13 7l5 5-5 5" />
							</svg>
						</span>
					)}
				</div>
			</li>
		))
	}
</ul>

<style>
	.showcase {
		--card-bg: #00443e;
		--card-bg-end: #003a35;
		--card-border: rgb(140 210 196 / 0.18);
		--card-ink: var(--on-accent); /* warm ivory */
		--card-muted: rgb(250 246 232 / 0.66);
		--card-hover: #9fd9cc; /* light teal for hovered titles */

		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.125rem;
	}

	@media (min-width: 640px) {
		.showcase {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.showcase {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--space-5);
		}
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1.125rem;
		padding: 1.125rem;
		background: linear-gradient(160deg, var(--card-bg), var(--card-bg-end));
		border: 1px solid var(--card-border);
		border-radius: 30px;
		color: var(--card-ink);
		transition: border-color var(--dur-base) var(--ease-out);
	}

	.card__media {
		overflow: hidden;
		aspect-ratio: 16 / 9;
		border-radius: 16px;
		background: rgb(250 246 232 / 0.06);
	}

	.card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		transition: transform var(--dur-base) var(--ease-out);
	}

	/* Title and category on the left, arrow on the right. */
	.card__foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding-inline: var(--space-1);
		margin-top: auto;
	}

	.card__title {
		font-size: clamp(1.5rem, 2.2vw, 1.875rem);
		font-weight: 400;
		line-height: 1.1;
		color: var(--card-ink);
	}

	.card__link {
		color: inherit;
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
	}

	/* Stretch the link over the whole card. */
	.card__link::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 30px;
	}

	.card__link:focus-visible {
		outline: none;
	}

	.card:has(.card__link:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.card__category {
		margin-top: var(--space-2);
		color: var(--card-muted);
	}

	.card__arrow {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid rgb(250 246 232 / 0.45);
		border-radius: 50%;
		color: var(--card-ink);
		transition: border-color var(--dur-base) var(--ease-out);
	}

	.card__arrow svg {
		transition: transform var(--dur-base) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.card--link:hover {
			border-color: rgb(140 210 196 / 0.45);
		}

		.card--link:hover .card__link {
			color: var(--card-hover);
		}

		.card--link:hover .card__img {
			transform: scale(1.02);
		}

		.card--link:hover .card__arrow {
			border-color: var(--card-hover);
		}

		.card--link:hover .card__arrow svg {
			transform: translateX(3px);
		}
	}

	.card:has(.card__link:focus-visible) .card__link {
		color: var(--card-hover);
	}
</style>
