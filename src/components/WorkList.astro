---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';

interface Props {
	projects: CollectionEntry<'projects'>[];
	/** Heading level for project titles: 3 under a section H2 (home), 2 under the page H1 (/work/). */
	headingLevel?: 2 | 3;
	/** Homepage: prefer the shorter homeSummary / homeTags, falling back to summary / stack. */
	home?: boolean;
}

const { projects, headingLevel = 3, home = false } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol class="work-list" role="list" data-work-list>
	{
		projects.map((project, i) => (
			<li class="work-row" data-reveal data-preview={project.data.title}>
				<div class="work-row__inner">
					<span class="work-row__num label">{pad(i + 1)}</span>
					<div class="work-row__head">
						<Heading class="work-row__title">
							<a class="work-row__link" href={`/work/${project.id}/`}>
								{project.data.title}
							</a>
						</Heading>
						<p class="label">{project.data.subtitle}</p>
					</div>
					<div class="work-row__body">
						<p>{(home && project.data.homeSummary) || project.data.summary}</p>
						<ul class="work-row__tags" role="list" aria-label="Tools">
							{((home && project.data.homeTags) || project.data.stack).map((tag) => (
								<li>
									<Tag>{tag}</Tag>
								</li>
							))}
						</ul>
					</div>
				</div>
			</li>
		))
	}
</ol>

<!-- Cursor-following preview (desktop, fine pointer, motion allowed). Swap for screenshots later. -->
<div class="work-preview" aria-hidden="true" data-work-preview>
	<span class="label" data-work-preview-label></span>
</div>

<script>
/* Selected work: a small preview that follows the cursor over each row.
   Only on wide screens with a mouse, and never for reduced-motion users. */
const list = document.querySelector<HTMLElement>('[data-work-list]');
const preview = document.querySelector<HTMLElement>('[data-work-preview]');
const label = preview?.querySelector<HTMLElement>('[data-work-preview-label]');
const enabled = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 768px) and (prefers-reduced-motion: no-preference)');

if (list && preview && label) {
	const OFFSET = 24;
	let x = 0;
	let y = 0;
	let targetX = 0;
	let targetY = 0;
	let pointerX = 0;
	let pointerY = 0;
	let frame = 0;
	let active: HTMLElement | null = null;

	const render = () => {
		preview.style.transform = `translate3d(${x}px, ${y}px, 0)`;
	};

	const tick = () => {
		x += (targetX - x) * 0.2;
		y += (targetY - y) * 0.2;
		render();
		frame = Math.abs(targetX - x) > 0.1 || Math.abs(targetY - y) > 0.1 ? requestAnimationFrame(tick) : 0;
	};

	const setTarget = (cx: number, cy: number) => {
		// Keep the preview inside the viewport near the right and bottom edges.
		targetX = Math.min(cx + OFFSET, window.innerWidth - preview.offsetWidth - OFFSET);
		targetY = Math.min(cy + OFFSET, window.innerHeight - preview.offsetHeight - OFFSET);
	};

	const hide = () => {
		active = null;
		preview.classList.remove('is-visible');
	};

	const update = () => {
		const row = document.elementFromPoint(pointerX, pointerY)?.closest<HTMLElement>('[data-preview]');
		if (!row || !list.contains(row)) {
			hide();
			return;
		}
		if (row !== active) {
			active = row;
			label.textContent = row.dataset.preview ?? '';
		}
		setTarget(pointerX, pointerY);
		if (!preview.classList.contains('is-visible')) {
			// Appear at the cursor rather than sliding in from the last position.
			x = targetX;
			y = targetY;
			render();
			preview.classList.add('is-visible');
		}
		if (!frame) frame = requestAnimationFrame(tick);
	};

	list.addEventListener('pointermove', (event) => {
		if (event.pointerType !== 'mouse' || !enabled.matches) return;
		pointerX = event.clientX;
		pointerY = event.clientY;
		update();
	});

	list.addEventListener('pointerleave', hide);

	// Scrolling moves rows under a still cursor, so re-check which row it's over.
	window.addEventListener('scroll', () => active && update(), { passive: true });
}
</script>

<style>
	/* --- Selected work --- */
	.work-row {
		position: relative;
		border-top: var(--hairline);
	}

	.work-row:last-child {
		border-bottom: var(--hairline);
	}

	.work-row__inner {
		position: relative;
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr);
		gap: var(--space-4);
		padding-block: var(--space-7);
	}

	.work-row__num {
		padding-top: 0.9rem;
	}

	.work-row__body {
		grid-column: 2;
	}

	.work-row__title {
		margin-bottom: var(--space-2);
		font-size: clamp(2rem, 4.5vw, 3.5rem);
		line-height: 1.05;
	}

	.work-row__link {
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
	}

	.work-row__link::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.work-row:hover .work-row__link {
		color: var(--accent);
	}

	.work-row__body p {
		color: var(--ink-2);
	}

	.work-row__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-4);
	}

	@media (min-width: 1024px) {
		.work-row__inner {
			grid-template-columns: 4rem minmax(0, 7fr) minmax(0, 5fr);
			gap: var(--space-6);
		}

		.work-row__body {
			grid-column: 3;
		}
	}

	.work-preview {
		display: none;
		position: fixed;
		top: 0;
		left: 0;
		z-index: 40;
		width: 16rem;
		aspect-ratio: 16 / 10;
		place-items: center;
		padding: var(--space-4);
		background: var(--paper-2);
		border: var(--hairline);
		border-radius: var(--radius);
		text-align: center;
		pointer-events: none;
		opacity: 0;
		transition: opacity var(--dur-fast) var(--ease-out);
	}

	.work-preview.is-visible {
		opacity: 1;
	}

	@media (hover: hover) and (pointer: fine) and (min-width: 768px) and (prefers-reduced-motion: no-preference) {
		.work-preview {
			display: grid;
		}
	}
</style>
